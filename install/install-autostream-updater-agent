create_temp_file() {
  local variable=$1
  local template=$2
  local temp_path=""
  defer_cleanup_signals
  temp_path=$(mktemp "${template}") || die "could not create temporary file from ${template}"
  printf -v "${variable}" '%s' "${temp_path}"
  resume_cleanup_signals || die "installation was interrupted while journaling a temporary file"
}

move_with_journal() {
  local source=$1
  local destination=$2
  local journal_variable=$3
  defer_cleanup_signals
  printf -v "${journal_variable}" '%s' true
  mv -fT -- "${source}" "${destination}"
  resume_cleanup_signals || die "installation was interrupted while journaling ${destination}"
}

move_with_identity_journal() {
  local source=$1
  local destination=$2
  local journal_variable=$3
  local identity_variable=$4
  defer_cleanup_signals
  printf -v "${journal_variable}" '%s' true
  mv -fT -- "${source}" "${destination}"
  printf -v "${identity_variable}" '%s' "$(stat -c '%d:%i' -- "${destination}")"
  resume_cleanup_signals || die "installation was interrupted while journaling ${destination}"
}

create_symlink_with_journal() {
  local target=$1
  local destination=$2
  local journal_variable=$3
  local identity_variable=$4
  defer_cleanup_signals
  printf -v "${journal_variable}" '%s' true
  ln -s -- "${target}" "${destination}"
  printf -v "${identity_variable}" '%s' "$(stat -c '%d:%i' -- "${destination}")"
  resume_cleanup_signals || die "installation was interrupted while journaling ${destination}"
}

rollback_created_directory() {
  local path=$1
  local expected_identity=$2
  local label=$3
  if [[ -z ${expected_identity} ||
    ! -d ${path} ||
    -L ${path} ||
    $(stat -c '%d:%i' -- "${path}" 2>/dev/null || true) != "${expected_identity}" ]]; then
    printf '%s\n' "install-autostream-host-agent: rollback refused changed ${label}; inspect ${path}" >&2
    return 1
  fi
  if ! rmdir -- "${path}"; then
    printf '%s\n' "install-autostream-host-agent: rollback could not remove new ${label}; inspect ${path}" >&2
    return 1
  fi
}

prepare_agent_user_rollback_login() {
  if id "${AGENT_USER}" >/dev/null 2>&1; then
    return 0
  fi
  [[ -z $(getent passwd "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    -z $(getent group "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  agent_account_member_fields_are_clear || return 1
  agent_user_rollback_login_ready=true
}

agent_account_member_fields_are_clear() {
  [[ -f /etc/group && ! -L /etc/group &&
    -f /etc/gshadow && ! -L /etc/gshadow ]] || return 1
  awk -F: \
    -v agent_login="${AGENT_USER}" \
    -v rollback_login="${AGENT_USER_ROLLBACK_LOGIN}" \
    '{
      count = split($4, members, ",")
      for (member_index = 1; member_index <= count; member_index++) {
        if (members[member_index] == agent_login || members[member_index] == rollback_login) {
          exit 1
        }
      }
    }' /etc/group || return 1
  awk -F: \
    -v agent_login="${AGENT_USER}" \
    -v rollback_login="${AGENT_USER_ROLLBACK_LOGIN}" \
    '{
      admin_count = split($3, admins, ",")
      for (admin_index = 1; admin_index <= admin_count; admin_index++) {
        if (admins[admin_index] == agent_login || admins[admin_index] == rollback_login) {
          exit 1
        }
      }
      member_count = split($4, members, ",")
      for (member_index = 1; member_index <= member_count; member_index++) {
        if (members[member_index] == agent_login || members[member_index] == rollback_login) {
          exit 1
        }
      }
    }' /etc/gshadow
}

agent_account_databases_match_digests() {
  local expected_group_digest=$1
  local expected_gshadow_digest=$2
  local group_digest
  local gshadow_digest

  group_digest="$(sha256sum -- /etc/group | awk 'NR == 1 { print $1 }')" || return 1
  gshadow_digest="$(sha256sum -- /etc/gshadow | awk 'NR == 1 { print $1 }')" || return 1
  [[ ${group_digest} =~ ^[[:xdigit:]]{64}$ &&
    ${gshadow_digest} =~ ^[[:xdigit:]]{64}$ &&
    ${group_digest} == "${expected_group_digest}" &&
    ${gshadow_digest} == "${expected_gshadow_digest}" ]]
}

restore_created_agent_user_login() {
  local expected_group_record=$1
  local renamed_user_record=$2
  local expected_group_digest=$3
  local expected_gshadow_digest=$4

  [[ -z $(getent passwd "${AGENT_USER}" 2>/dev/null || true) &&
    $(getent passwd "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) == \
      "${renamed_user_record}" &&
    -z $(getent group "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  usermod --login "${AGENT_USER}" "${AGENT_USER_ROLLBACK_LOGIN}" || return 1
  [[ $(getent passwd "${AGENT_USER}" 2>/dev/null || true) == \
      "${agent_user_identity}" &&
    -z $(getent passwd "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    -z $(getent group "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  agent_account_databases_match_digests \
    "${expected_group_digest}" "${expected_gshadow_digest}" || return 1
  [[ $(getent group "${AGENT_GROUP}" 2>/dev/null || true) == "${expected_group_record}" ]]
}

remove_created_agent_user_preserving_group() {
  local delete_status=0
  local expected_group_gid
  local expected_group_record
  local group_database_digest_before
  local gshadow_database_digest_before
  local rename_status=0
  local renamed_user_record
  local record_gid
  local record_home
  local record_login
  local record_shell
  local record_uid
  local user_record_suffix

  IFS=: read -r record_login _ record_uid record_gid _ record_home record_shell <<<"${agent_user_identity}"
  [[ ${agent_user_created} == true &&
    ${agent_user_rollback_login_ready} == true &&
    ${record_login} == "${AGENT_USER}" &&
    ${record_uid} =~ ^[1-9][0-9]*$ &&
    ${record_uid} == "${agent_user_uid}" &&
    ${record_gid} =~ ^[1-9][0-9]*$ &&
    ${record_gid} == "${agent_user_gid}" &&
    ${record_home} == "${STATE_DIR}" &&
    ${record_shell} == "/usr/sbin/nologin" &&
    $(getent passwd "${AGENT_USER}" 2>/dev/null || true) == "${agent_user_identity}" &&
    $(id -u "${AGENT_USER}" 2>/dev/null || true) == "${agent_user_uid}" &&
    $(id -g "${AGENT_USER}" 2>/dev/null || true) == "${agent_user_gid}" ]] || \
    return 1

  if [[ ${agent_group_created} == true ]]; then
    expected_group_record="${agent_group_identity}"
  else
    expected_group_record="${preexisting_agent_group_identity}"
  fi
  [[ -n ${expected_group_record} &&
    $(getent group "${AGENT_GROUP}" 2>/dev/null || true) == "${expected_group_record}" ]] || \
    return 1
  expected_group_gid="$(printf '%s\n' "${expected_group_record}" | awk -F: -v group_name="${AGENT_GROUP}" 'NR == 1 && $1 == group_name { print $3 }')"
  [[ ${expected_group_gid} =~ ^[1-9][0-9]*$ &&
    ${agent_user_gid} == "${expected_group_gid}" &&
    -z $(getent passwd "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    -z $(getent group "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1

  group_database_digest_before="$(sha256sum -- /etc/group | awk 'NR == 1 { print $1 }')" || return 1
  gshadow_database_digest_before="$(sha256sum -- /etc/gshadow | awk 'NR == 1 { print $1 }')" || return 1
  [[ ${group_database_digest_before} =~ ^[[:xdigit:]]{64}$ &&
    ${gshadow_database_digest_before} =~ ^[[:xdigit:]]{64}$ ]] || return 1
  agent_account_member_fields_are_clear || return 1
  agent_account_databases_match_digests \
    "${group_database_digest_before}" "${gshadow_database_digest_before}" || return 1

  # Ubuntu may automatically delete an empty user-private group whose name
  # matches the login. Rename only this invocation's user before userdel so the
  # protected Host Agent group cannot match the deleted login.
  user_record_suffix="${agent_user_identity#"${AGENT_USER}"}"
  renamed_user_record="${AGENT_USER_ROLLBACK_LOGIN}${user_record_suffix}"
  if usermod --login "${AGENT_USER_ROLLBACK_LOGIN}" "${AGENT_USER}"; then
    :
  else
    rename_status=$?
  fi
  if [[ ${rename_status} -ne 0 ||
    -n $(getent passwd "${AGENT_USER}" 2>/dev/null || true) ||
    $(getent passwd "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) != \
      "${renamed_user_record}" ||
    $(getent group "${AGENT_GROUP}" 2>/dev/null || true) != "${expected_group_record}" ||
    -n $(getent group "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]]; then
    restore_created_agent_user_login \
      "${expected_group_record}" "${renamed_user_record}" \
      "${group_database_digest_before}" "${gshadow_database_digest_before}" || true
    return 1
  fi
  if ! agent_account_databases_match_digests \
    "${group_database_digest_before}" "${gshadow_database_digest_before}"; then
    restore_created_agent_user_login \
      "${expected_group_record}" "${renamed_user_record}" \
      "${group_database_digest_before}" "${gshadow_database_digest_before}" || true
    return 1
  fi

  if userdel "${AGENT_USER_ROLLBACK_LOGIN}"; then
    delete_status=0
  else
    delete_status=$?
  fi
  if [[ ${delete_status} -ne 0 ]]; then
    restore_created_agent_user_login \
      "${expected_group_record}" "${renamed_user_record}" \
      "${group_database_digest_before}" "${gshadow_database_digest_before}" || true
    return 1
  fi
  [[ -z $(getent passwd "${AGENT_USER}" 2>/dev/null || true) &&
    -z $(getent passwd "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    $(getent group "${AGENT_GROUP}" 2>/dev/null || true) == "${expected_group_record}" &&
    -z $(getent group "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    return 1
  agent_account_databases_match_digests \
    "${group_database_digest_before}" "${gshadow_database_digest_before}" || return 1
  agent_user_created=false
  agent_user_uid=""
  agent_user_gid=""
  agent_user_identity=""
}

rollback_created_account() {
  local failed=false
  local current_identity=""
  if [[ ${agent_user_creation_attempted} == true &&
    ${agent_user_created} == false ]] &&
    current_identity=$(getent passwd "${AGENT_USER}" 2>/dev/null); then
    printf '%s\n' "install-autostream-host-agent: rollback cannot prove ownership of the newly appeared ${AGENT_USER} account" >&2
    failed=true
  fi
  if [[ ${agent_user_created} == true ]] &&
    ! remove_created_agent_user_preserving_group; then
    printf '%s\n' "install-autostream-host-agent: rollback could not safely remove ${AGENT_USER} account" >&2
    failed=true
  fi
  if [[ ${agent_group_creation_attempted} == true &&
    ${agent_group_created} == false ]] &&
    current_identity=$(getent group "${AGENT_GROUP}" 2>/dev/null); then
    printf '%s\n' "install-autostream-host-agent: rollback cannot prove ownership of the newly appeared ${AGENT_GROUP} group" >&2
    failed=true
  fi
  if [[ ${agent_group_created} == true && ${agent_user_created} == true ]]; then
    failed=true
  elif [[ ${agent_group_created} == true ]]; then
    current_identity=$(getent group "${AGENT_GROUP}" 2>/dev/null || true)
    if [[ -z ${agent_group_identity} || ${current_identity} != "${agent_group_identity}" ]]; then
      printf '%s\n' "install-autostream-host-agent: rollback refused changed ${AGENT_GROUP} group" >&2
      failed=true
    elif ! groupdel "${AGENT_GROUP}"; then
      printf '%s\n' "install-autostream-host-agent: rollback could not remove ${AGENT_GROUP} group" >&2
      failed=true
    elif getent group "${AGENT_GROUP}" >/dev/null 2>&1; then
      printf '%s\n' "install-autostream-host-agent: rollback could not prove removal of ${AGENT_GROUP} group" >&2
      failed=true
    else
      agent_group_created=false
      agent_group_identity=""
    fi
  fi
  [[ ${failed} == false ]]
}

validate_state_tree() {
  local root=$1
  local root_device
  local entry
  root_device=$(stat -c '%d' -- "${root}") || die "could not read the Host Agent state filesystem"
  while IFS= read -r -d '' entry; do
    if [[ -L ${entry} || ( ! -d ${entry} && ! -f ${entry} ) ]]; then
      printf '%s\n' "install-autostream-host-agent: Host Agent state contains a symlink or special file: ${entry}" >&2
      return 1
    fi
    if [[ $(stat -c '%d' -- "${entry}") != "${root_device}" ]]; then
      printf '%s\n' "install-autostream-host-agent: Host Agent state contains a nested mount: ${entry}" >&2
      return 1
    fi
  done < <(find "${root}" -xdev -mindepth 1 -print0)
}

snapshot_host_agent_state() {
  [[ ${install_mode} == "configured" && ${state_dir_existed} == true ]] || return
  [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} &&
    $(stat -c '%d:%i' -- "${STATE_DIR}") == "${state_dir_identity}" ]] || \
    die "Host Agent state directory changed before snapshot"
  validate_state_tree "${STATE_DIR}" || die "existing Host Agent state is unsafe to snapshot"
  state_snapshot="${BUNDLE_STAGE}/host-agent-state.before.tar"
  tar --numeric-owner --one-file-system -cpf "${state_snapshot}" -C "${STATE_DIR}" . || \
    die "could not snapshot existing Host Agent state"
  [[ -f ${state_snapshot} && ! -L ${state_snapshot} ]] || \
    die "Host Agent state snapshot is missing or unsafe"
  state_snapshot_ready=true
}

restore_host_agent_state() {
  local root_device
  local entry
  local snapshot_device
  local snapshot_inode
  local snapshot_uid
  local snapshot_gid
  local snapshot_mode
  if [[ ${state_dir_existed} == true && ${state_snapshot_ready} == true ]]; then
    IFS=: read -r snapshot_device snapshot_inode snapshot_uid snapshot_gid snapshot_mode \
      <<<"${state_root_snapshot}"
    [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} &&
      $(stat -c '%d:%i' -- "${STATE_DIR}") == "${snapshot_device}:${snapshot_inode}" ]] || {
      printf '%s\n' 'install-autostream-host-agent: rollback refused a replaced Host Agent state root' >&2
      return 1
    }
    validate_state_tree "${STATE_DIR}" || return 1
    find "${STATE_DIR}" -xdev -mindepth 1 -delete || return 1
    tar --numeric-owner --same-owner --same-permissions -xpf "${state_snapshot}" \
      -C "${STATE_DIR}" || return 1
    chown "${snapshot_uid}:${snapshot_gid}" -- "${STATE_DIR}" || return 1
    chmod "${snapshot_mode}" -- "${STATE_DIR}" || return 1
    [[ $(stat -c '%d:%i:%u:%g:%a' -- "${STATE_DIR}") == "${state_root_snapshot}" ]] || \
      return 1
    return
  fi
  if [[ ${state_dir_created} == true ]]; then
    [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} &&
      $(stat -c '%d:%i' -- "${STATE_DIR}" 2>/dev/null || true) == "${state_dir_identity}" ]] || {
      printf '%s\n' 'install-autostream-host-agent: rollback refused a replaced fresh Host Agent state root' >&2
      return 1
    }
    root_device=$(stat -c '%d' -- "${STATE_DIR}") || return 1
    while IFS= read -r -d '' entry; do
      [[ ! -L ${entry} && ( -d ${entry} || -f ${entry} ) &&
        $(stat -c '%d' -- "${entry}") == "${root_device}" ]] || {
        printf '%s\n' "install-autostream-host-agent: rollback refused unsafe fresh state entry ${entry}" >&2
        return 1
      }
    done < <(find "${STATE_DIR}" -xdev -mindepth 1 -print0)
    find "${STATE_DIR}" -xdev -mindepth 1 -delete || return 1
    rollback_created_directory "${STATE_DIR}" "${state_dir_identity}" "Host Agent state directory" ||
      return 1
    state_dir_created=false
  fi
}

rollback_bootstrap_prerequisites() {
  local failed=false
  local rollback_accounts=${1:-true}
  if [[ ${state_dir_created} == true ]] &&
    ! rollback_created_directory \
      "${STATE_DIR}" "${state_dir_identity}" "Host Agent state directory"; then
    failed=true
  fi
  if [[ ${identity_config_dir_created} == true ]] &&
    ! rollback_created_directory \
      "${CONFIG_DIR}" "${identity_config_dir_identity}" "Host Agent identity directory"; then
    failed=true
  fi
  if [[ ${opt_autostream_dir_created} == true ]] &&
    ! rollback_created_directory \
      /opt/autostream "${opt_autostream_dir_identity}" "/opt/autostream directory"; then
    failed=true
  fi
  if [[ ${etc_tmpfiles_dir_created} == true ]] &&
    ! rollback_created_directory \
      /etc/tmpfiles.d "${etc_tmpfiles_dir_identity}" "/etc/tmpfiles.d directory"; then
    failed=true
  fi
  if [[ ${usr_local_libexec_dir_created} == true ]] &&
    ! rollback_created_directory \
      /usr/local/libexec "${usr_local_libexec_dir_identity}" "/usr/local/libexec directory"; then
    failed=true
  fi
  if [[ ${systemd_system_dir_created} == true ]] &&
    ! rollback_created_directory \
      /etc/systemd/system "${systemd_system_dir_identity}" "/etc/systemd/system directory"; then
    failed=true
  fi
  if [[ ${usr_local_bin_dir_created} == true ]] &&
    ! rollback_created_directory \
      /usr/local/bin "${usr_local_bin_dir_identity}" "/usr/local/bin directory"; then
    failed=true
  fi
  if [[ ${etc_autostream_dir_created} == true ]] &&
    ! rollback_created_directory \
      /etc/autostream "${etc_autostream_dir_identity}" "/etc/autostream directory"; then
    failed=true
  fi
  if [[ ${rollback_accounts} == true ]] &&
    ! rollback_created_account; then
    failed=true
  fi
  [[ ${failed} == false ]]
}

unit_active_state() {
  local unit=$1
  local state=""
  local status=0
  if state=$(systemctl is-active "${unit}" 2>/dev/null); then
    status=0
  else
    status=$?
  fi
  case "${status}:${state}" in
    0:active) printf '%s\n' active ;;
    3:inactive|4:inactive|4:unknown) printf '%s\n' inactive ;;
    *) die "could not establish a stable active state for ${unit}" ;;
  esac
}

unit_enabled_state() {
  local unit=$1
  local state=""
  local status=0
  if state=$(systemctl is-enabled "${unit}" 2>/dev/null); then
    status=0
  else
    status=$?
  fi
  case "${status}:${state}" in
    0:enabled) printf '%s\n' enabled ;;
    1:disabled|1:not-found|4:not-found) printf '%s\n' disabled ;;
    *) die "could not establish a stable enablement state for ${unit}" ;;
  esac
}

verify_unit_inactive() {
  local unit=$1
  [[ $(unit_active_state "${unit}") == "inactive" ]] || \
    die "${unit} did not reach the inactive state"
}

verify_unit_active() {
  local unit=$1
  [[ $(unit_active_state "${unit}") == "active" ]] || \
    die "${unit} did not reach the active state"
}

verify_unit_disabled() {
  local unit=$1
  [[ $(unit_enabled_state "${unit}") == "disabled" ]] || \
    die "${unit} did not reach the disabled state"
}

cleanup_bootstrap() {
  local status=$?
  local rollback_failed=false
  trap '' INT TERM
  trap - EXIT
  [[ -z ${config_stage:-} ]] || rm -f -- "${config_stage}"
  [[ -z ${binary_stage:-} ]] || rm -f -- "${binary_stage}"
  [[ -z ${unit_stage:-} ]] || rm -f -- "${unit_stage}"
  [[ -z ${local_executor_binary_stage:-} ]] || rm -f -- "${local_executor_binary_stage}"
  [[ -z ${local_executor_service_stage:-} ]] || rm -f -- "${local_executor_service_stage}"
  [[ -z ${local_executor_socket_stage:-} ]] || rm -f -- "${local_executor_socket_stage}"
  [[ -z ${local_executor_tmpfiles_stage:-} ]] || rm -f -- "${local_executor_tmpfiles_stage}"
  [[ -z ${self_update_recovery_service_stage:-} ]] || rm -f -- "${self_update_recovery_service_stage}"
  [[ -z ${self_update_recovery_timer_stage:-} ]] || rm -f -- "${self_update_recovery_timer_stage}"
  rollback_bootstrap_prerequisites || rollback_failed=true
  if [[ -n ${BUNDLE_STAGE:-} &&
    ${BUNDLE_STAGE} == /var/tmp/autostream-host-agent-install.* &&
    -d ${BUNDLE_STAGE} &&
    ! -L ${BUNDLE_STAGE} ]]; then
    rm -rf -- "${BUNDLE_STAGE}"
  fi
  if [[ ${rollback_failed} == true ]]; then
    exit 1
  fi
  exit "${status}"
}
arm_cleanup_handler cleanup_bootstrap

if [[ ${install_mode} == "prepare" ]]; then
  [[ ! -e ${CONFIG_DEST} && ! -L ${CONFIG_DEST} &&
    ! -e ${LEGACY_CONFIG_DEST} && ! -L ${LEGACY_CONFIG_DEST} ]] || \
    die "--prepare refuses an existing identity; use --config PATH for a configured installation"
  [[ ! -e ${LOCAL_EXECUTOR_POLICY_DEST} && ! -L ${LOCAL_EXECUTOR_POLICY_DEST} ]] || \
    die "--prepare refuses an existing local executor policy; use the local executor installer for upgrades"
  [[ $(unit_active_state "${UNIT_NAME}") == "inactive" ]] || \
    die "--prepare requires the Host Agent service to be inactive"
  [[ $(unit_enabled_state "${UNIT_NAME}") == "disabled" ]] || \
    die "--prepare requires the Host Agent service to be disabled"
  for runtime_unit in \
    "${LOCAL_EXECUTOR_SERVICE_NAME}" \
    "${LOCAL_EXECUTOR_SOCKET_NAME}" \
    "${SELF_UPDATE_RECOVERY_SERVICE_A}" \
    "${SELF_UPDATE_RECOVERY_SERVICE_B}" \
    "${SELF_UPDATE_RECOVERY_TIMER_A}" \
    "${SELF_UPDATE_RECOVERY_TIMER_B}"; do
    [[ $(unit_active_state "${runtime_unit}") == "inactive" ]] || \
      die "--prepare requires the local executor and self-update recovery timers to be inactive"
  done
  for runtime_unit in \
    "${LOCAL_EXECUTOR_SERVICE_NAME}" \
    "${LOCAL_EXECUTOR_SOCKET_NAME}" \
    "${SELF_UPDATE_RECOVERY_TIMER_A}" \
    "${SELF_UPDATE_RECOVERY_TIMER_B}"; do
    [[ $(unit_enabled_state "${runtime_unit}") == "disabled" ]] || \
      die "--prepare requires the local executor and self-update recovery timers to be disabled"
  done
  [[ ! -e ${HOST_RUNTIME_ROOT} && ! -L ${HOST_RUNTIME_ROOT} ]] || \
    die "--prepare refuses an existing Host Agent A/B runtime root"
fi

prepare_agent_user_rollback_login || \
  die "could not reserve a safe Host Agent account rollback login"
if ! getent group "${AGENT_GROUP}" >/dev/null; then
  agent_group_creation_attempted=true
  defer_cleanup_signals
  groupadd --system "${AGENT_GROUP}"
  agent_group_created=true
  agent_group_identity=$(getent group "${AGENT_GROUP}") || \
    die "could not record the newly created Host Agent group"
  resume_cleanup_signals || die "installation was interrupted while journaling the Host Agent group"
else
  preexisting_agent_group_identity="$(getent group "${AGENT_GROUP}" 2>/dev/null || true)"
  [[ -n ${preexisting_agent_group_identity} ]] || \
    die "could not record the pre-existing Host Agent group"
fi
IFS=: read -r _ _ agent_gid _ < <(getent group "${AGENT_GROUP}")
[[ ${agent_gid} =~ ^[0-9]+$ && ${agent_gid} -ne 0 ]] || \
  die "agent group must use a non-root numeric gid"
if [[ ${agent_group_created} == true ]]; then
  [[ $(getent group "${AGENT_GROUP}" 2>/dev/null || true) == "${agent_group_identity}" ]] || \
    die "newly created Host Agent group changed before user provisioning"
else
  [[ $(getent group "${AGENT_GROUP}" 2>/dev/null || true) == "${preexisting_agent_group_identity}" ]] || \
    die "pre-existing Host Agent group changed before user provisioning"
fi
if ! id "${AGENT_USER}" >/dev/null 2>&1; then
  [[ ${agent_user_rollback_login_ready} == true &&
    -z $(getent passwd "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) &&
    -z $(getent group "${AGENT_USER_ROLLBACK_LOGIN}" 2>/dev/null || true) ]] || \
    die "Host Agent account rollback login reservation changed before user provisioning"
  agent_account_member_fields_are_clear || \
    die "Host Agent account membership changed before user provisioning"
  agent_user_creation_attempted=true
  defer_cleanup_signals
  useradd \
    --system \
    --gid "${AGENT_GROUP}" \
    --home-dir "${STATE_DIR}" \
    --shell /usr/sbin/nologin \
    "${AGENT_USER}"
  agent_user_created=true
  agent_user_identity=$(getent passwd "${AGENT_USER}") || \
    die "could not record the newly created Host Agent account"
  agent_user_uid="$(id -u "${AGENT_USER}" 2>/dev/null || true)"
  agent_user_gid="$(id -g "${AGENT_USER}" 2>/dev/null || true)"
  [[ ${agent_user_uid} =~ ^[1-9][0-9]*$ &&
    ${agent_user_gid} == "${agent_gid}" ]] || \
    die "could not record the newly created Host Agent account identity"
  resume_cleanup_signals || die "installation was interrupted while journaling the Host Agent account"
fi
[[ $(id -u "${AGENT_USER}") -ne 0 ]] || die "agent user must not be root"
[[ $(id -gn "${AGENT_USER}") == "${AGENT_GROUP}" ]] || die "agent user must use the dedicated primary group"
mapfile -t supplementary_groups < <(id -Gn "${AGENT_USER}" | tr ' ' '\n' | LC_ALL=C sort -u)
[[ ${#supplementary_groups[@]} -eq 1 && ${supplementary_groups[0]} == "${AGENT_GROUP}" ]] || \
  die "agent user must not belong to supplementary groups"
IFS=: read -r _ _ agent_gid agent_group_members < <(getent group "${AGENT_GROUP}")
[[ ${agent_gid} =~ ^[0-9]+$ && ${agent_gid} -ne 0 ]] || \
  die "agent group has an invalid or root gid"
if [[ -n ${agent_group_members} ]]; then
  IFS=, read -r -a explicit_group_members <<<"${agent_group_members}"
  for member in "${explicit_group_members[@]}"; do
    [[ ${member} == "${AGENT_USER}" ]] || die "agent group must not grant identity access to another user"
  done
fi
while IFS=: read -r account_name _ _ account_gid _ _ _; do
  if [[ ${account_gid} == "${agent_gid}" && ${account_name} != "${AGENT_USER}" ]]; then
    die "agent group must not be the primary group of another user"
  fi
done < <(getent passwd)
