validate_active_job_recovery_executable() {
  local path=$1
  local label=$2
  active_job_recovery_executable_is_safe "${path}" || \
    die "${label} executable is missing or unsafe"
}

active_job_recovery_executable_is_safe() {
  local path=$1
  [[ -f ${path} && ! -L ${path} && -x ${path} &&
    $(readlink -f -- "${path}") == "${path}" ]] || return 1
  [[ $(stat -c '%U:%G:%a:%h' -- "${path}") == "root:root:755:1" ]] || \
    return 1
  active_job_recovery_root_parent_chain_is_safe "${path}"
}

active_job_recovery_verified_candidate_sources_are_intact() {
  [[ -f ${BINARY_SOURCE} && ! -L ${BINARY_SOURCE} &&
    $(readlink -f -- "${BINARY_SOURCE}") == "${BINARY_SOURCE}" &&
    $(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- "${BINARY_SOURCE}") == \
      "${VERIFIED_AGENT_SOURCE_STAT}" &&
    $(sha256sum -- "${BINARY_SOURCE}" | awk 'NR == 1 { print $1 }') == \
      "${VERIFIED_AGENT_SOURCE_SHA256}" &&
    -f ${LOCAL_EXECUTOR_BINARY_SOURCE} &&
    ! -L ${LOCAL_EXECUTOR_BINARY_SOURCE} &&
    $(readlink -f -- "${LOCAL_EXECUTOR_BINARY_SOURCE}") == \
      "${LOCAL_EXECUTOR_BINARY_SOURCE}" &&
    $(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- \
      "${LOCAL_EXECUTOR_BINARY_SOURCE}") == "${VERIFIED_EXECUTOR_SOURCE_STAT}" &&
    $(sha256sum -- "${LOCAL_EXECUTOR_BINARY_SOURCE}" | \
      awk 'NR == 1 { print $1 }') == "${VERIFIED_EXECUTOR_SOURCE_SHA256}" ]]
}

active_job_recovery_service_is_enabled_active() {
  local enabled_state
  local active_state
  local main_pid
  enabled_state="$(${SYSTEMCTL_PATH} is-enabled "${UNIT_NAME}" 2>/dev/null)" || return 1
  active_state="$(${SYSTEMCTL_PATH} is-active "${UNIT_NAME}" 2>/dev/null)" || return 1
  main_pid="$(${SYSTEMCTL_PATH} show "${UNIT_NAME}" --property=MainPID --value 2>/dev/null)" || return 1
  [[ ${enabled_state} == "enabled" &&
    ${active_state} == "active" &&
    ${main_pid} =~ ^[1-9][0-9]*$ ]]
}

active_job_recovery_service_is_managed() {
  local expected_executable
  local first_executable
  local first_pid
  local second_executable
  local second_pid
  local unit_group
  local unit_user
  active_job_recovery_service_is_enabled_active || return 1
  unit_user="$(${SYSTEMCTL_PATH} show \
    "${UNIT_NAME}" --property=User --value 2>/dev/null)" || return 1
  unit_group="$(${SYSTEMCTL_PATH} show \
    "${UNIT_NAME}" --property=Group --value 2>/dev/null)" || return 1
  [[ ${unit_user} == "${AGENT_USER}" &&
    ${unit_group} == "${AGENT_GROUP}" ]] || return 1
  first_pid="$(${SYSTEMCTL_PATH} show \
    "${UNIT_NAME}" --property=MainPID --value 2>/dev/null)" || return 1
  [[ ${first_pid} =~ ^[1-9][0-9]*$ &&
    -d /proc/${first_pid} &&
    ! -L /proc/${first_pid} ]] || return 1
  expected_executable="$(readlink -f -- \
    "${HOST_RUNTIME_CURRENT}/bin/autostream-host-agent")" || return 1
  case "${expected_executable}" in
    "${HOST_RUNTIME_SLOTS}"/a/bin/autostream-host-agent|"${HOST_RUNTIME_SLOTS}"/b/bin/autostream-host-agent) ;;
    *) return 1 ;;
  esac
  [[ -f ${expected_executable} && ! -L ${expected_executable} &&
    -x ${expected_executable} &&
    $(readlink -f -- "${BINARY_DEST}") == "${expected_executable}" ]] || return 1
  first_executable="$(readlink -f -- "/proc/${first_pid}/exe")" || return 1
  [[ ${first_executable} == "${expected_executable}" ]] || return 1
  second_pid="$(${SYSTEMCTL_PATH} show \
    "${UNIT_NAME}" --property=MainPID --value 2>/dev/null)" || return 1
  [[ ${second_pid} == "${first_pid}" ]] || return 1
  second_executable="$(readlink -f -- "/proc/${second_pid}/exe")" || return 1
  [[ ${second_executable} == "${expected_executable}" ]]
}

read_active_job_recovery_binary_identity() {
  local binary_path=$1
  local binary_name=$2
  local expected_pair=$3
  local build_date
  local commit
  local version
  local -a lines=()
  mapfile -t lines < <("${binary_path}" --version) || return 1
  case "${binary_name}" in
    autostream-host-agent)
      [[ ${#lines[@]} -eq 3 ]] || return 1
      [[ ${lines[0]} =~ ^autostream-host-agent\ (v[0-9]+[.][0-9]+[.][0-9]+)$ ]] || \
        return 1
      version=${BASH_REMATCH[1]}
      ;;
    autostream-local-executor)
      [[ ${#lines[@]} -eq 5 ]] || return 1
      [[ ${lines[0]} =~ ^autostream-local-executor\ (v[0-9]+[.][0-9]+[.][0-9]+)$ ]] || \
        return 1
      version=${BASH_REMATCH[1]}
      [[ ${lines[3]} == "mutation_protocol: 2" &&
        ${lines[4]} == "recovery_protocol: 2" ]] || return 1
      ;;
    *) return 1 ;;
  esac
  [[ ${lines[1]} =~ ^commit:\ ([0-9a-f]{40})$ ]] || return 1
  commit=${BASH_REMATCH[1]}
  [[ ${lines[2]} =~ ^build_date:\ ([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)$ ]] || \
    return 1
  build_date=${BASH_REMATCH[1]}
  case "${expected_pair}" in
    rescue-source)
      case "${version}" in
        v1.9.9|v1.9.10) ;;
        *) return 1 ;;
      esac
      ;;
    verified-candidate)
      [[ ${version} == "${VERSION}" &&
        ${commit} == "${MANIFEST_COMMIT}" &&
        ${build_date} == "${MANIFEST_BUILD_DATE}" ]] || return 1
      ;;
    *) return 1 ;;
  esac
  printf '%s\t%s\t%s\n' "${version}" "${commit}" "${build_date}"
}

active_job_recovery_live_pair_is_managed() {
  local expected_pair=${1:-rescue-source}
  local current_agent
  local current_executor
  local current_slot_root
  local current_target
  local directory
  local executor_first_executable
  local executor_first_pid
  local executor_group
  local executor_second_executable
  local executor_second_pid
  local executor_user
  local first_agent_identity
  local first_agent_sha256
  local first_agent_stat
  local first_executor_identity
  local first_executor_sha256
  local first_executor_stat
  local second_agent_identity
  local second_executor_identity

  case "${expected_pair}" in
    rescue-source) ;;
    verified-candidate)
      active_job_recovery_verified_candidate_sources_are_intact || return 1
      ;;
    *) return 1 ;;
  esac

  [[ -L ${HOST_RUNTIME_CURRENT} &&
    $(stat -c '%U:%G:%h' -- "${HOST_RUNTIME_CURRENT}") == "root:root:1" ]] || \
    return 1
  current_target="$(readlink -- "${HOST_RUNTIME_CURRENT}")" || return 1
  case "${current_target}" in
    slots/a|slots/b) ;;
    *) return 1 ;;
  esac
  current_slot_root="${HOST_RUNTIME_SLOTS}/${current_target#slots/}"
  current_agent="$(readlink -f -- \
    "${HOST_RUNTIME_CURRENT}/bin/autostream-host-agent")" || return 1
  current_executor="$(readlink -f -- \
    "${HOST_RUNTIME_CURRENT}/bin/autostream-local-executor")" || return 1
  [[ ${current_agent} == \
      "${current_slot_root}/bin/autostream-host-agent" &&
    ${current_executor} == \
      "${current_slot_root}/bin/autostream-local-executor" ]] || \
    return 1
  for directory in \
    "${HOST_RUNTIME_ROOT}" \
    "${HOST_RUNTIME_SLOTS}" \
    "${current_slot_root}" \
    "${current_slot_root}/bin"; do
    [[ -d ${directory} && ! -L ${directory} &&
      $(readlink -f -- "${directory}") == "${directory}" &&
      $(stat -c '%U:%G:%a' -- "${directory}") == "root:root:755" ]] || \
      return 1
  done
  active_job_recovery_executable_is_safe "${current_agent}" || return 1
  active_job_recovery_executable_is_safe "${current_executor}" || return 1
  ${RUNUSER_PATH} --user "${AGENT_USER}" -- \
    "${ENV_PATH}" -i \
    HOME=/nonexistent \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    LC_ALL=C \
    "${TEST_PATH}" -r "${current_agent}" || return 1
  ${RUNUSER_PATH} --user "${AGENT_USER}" -- \
    "${ENV_PATH}" -i \
    HOME=/nonexistent \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    LC_ALL=C \
    "${TEST_PATH}" -x "${current_agent}" || return 1
  ${RUNUSER_PATH} --user "${AGENT_USER}" -- \
    "${ENV_PATH}" -i \
    HOME=/nonexistent \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    LC_ALL=C \
    "${TEST_PATH}" -r "${current_executor}" || return 1
  ${RUNUSER_PATH} --user "${AGENT_USER}" -- \
    "${ENV_PATH}" -i \
    HOME=/nonexistent \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    LC_ALL=C \
    "${TEST_PATH}" -x "${current_executor}" || return 1
  [[ -L ${BINARY_DEST} &&
    $(stat -c '%U:%G:%h' -- "${BINARY_DEST}") == "root:root:1" &&
    $(readlink -- "${BINARY_DEST}") == \
      "${HOST_RUNTIME_CURRENT}/bin/autostream-host-agent" &&
    $(readlink -f -- "${BINARY_DEST}") == "${current_agent}" ]] || return 1
  [[ -L ${LOCAL_EXECUTOR_BINARY_DEST} &&
    $(stat -c '%U:%G:%h' -- "${LOCAL_EXECUTOR_BINARY_DEST}") == "root:root:1" &&
    $(readlink -- "${LOCAL_EXECUTOR_BINARY_DEST}") == \
      "${HOST_RUNTIME_CURRENT}/bin/autostream-local-executor" &&
    $(readlink -f -- "${LOCAL_EXECUTOR_BINARY_DEST}") == "${current_executor}" ]] || \
    return 1

  first_agent_stat="$(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- \
    "${current_agent}")" || return 1
  first_executor_stat="$(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- \
    "${current_executor}")" || return 1
  if [[ ${expected_pair} == verified-candidate ]]; then
    first_agent_sha256="$(sha256sum -- "${current_agent}" | \
      awk 'NR == 1 { print $1 }')" || return 1
    first_executor_sha256="$(sha256sum -- "${current_executor}" | \
      awk 'NR == 1 { print $1 }')" || return 1
    [[ ${first_agent_sha256} == "${VERIFIED_AGENT_SOURCE_SHA256}" &&
      ${first_executor_sha256} == "${VERIFIED_EXECUTOR_SOURCE_SHA256}" ]] || \
      return 1
  fi
  first_agent_identity="$(read_active_job_recovery_binary_identity \
    "${current_agent}" autostream-host-agent "${expected_pair}")" || return 1
  first_executor_identity="$(read_active_job_recovery_binary_identity \
    "${current_executor}" autostream-local-executor "${expected_pair}")" || return 1
  [[ ${first_agent_identity} == "${first_executor_identity}" ]] || return 1

  [[ $(${SYSTEMCTL_PATH} is-active \
      "${LOCAL_EXECUTOR_SERVICE_NAME}" 2>/dev/null) == "active" &&
    $(${SYSTEMCTL_PATH} is-enabled \
      "${LOCAL_EXECUTOR_SOCKET_NAME}" 2>/dev/null) == "enabled" &&
    $(${SYSTEMCTL_PATH} is-active \
      "${LOCAL_EXECUTOR_SOCKET_NAME}" 2>/dev/null) == "active" ]] || return 1
  executor_user="$(${SYSTEMCTL_PATH} show "${LOCAL_EXECUTOR_SERVICE_NAME}" \
    --property=User --value 2>/dev/null)" || return 1
  executor_group="$(${SYSTEMCTL_PATH} show "${LOCAL_EXECUTOR_SERVICE_NAME}" \
    --property=Group --value 2>/dev/null)" || return 1
  [[ ${executor_user} == "root" && ${executor_group} == "root" ]] || return 1
  executor_first_pid="$(${SYSTEMCTL_PATH} show \
    "${LOCAL_EXECUTOR_SERVICE_NAME}" --property=MainPID --value 2>/dev/null)" || \
    return 1
  [[ ${executor_first_pid} =~ ^[1-9][0-9]*$ &&
    -d /proc/${executor_first_pid} &&
    ! -L /proc/${executor_first_pid} ]] || return 1
  executor_first_executable="$(readlink -f -- \
    "/proc/${executor_first_pid}/exe")" || return 1
  [[ ${executor_first_executable} == "${current_executor}" ]] || return 1

  active_job_recovery_executable_is_safe "${current_agent}" || return 1
  active_job_recovery_executable_is_safe "${current_executor}" || return 1
  [[ $(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- "${current_agent}") == \
      "${first_agent_stat}" &&
    $(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- "${current_executor}") == \
      "${first_executor_stat}" ]] || return 1
  second_agent_identity="$(read_active_job_recovery_binary_identity \
    "${current_agent}" autostream-host-agent "${expected_pair}")" || return 1
  second_executor_identity="$(read_active_job_recovery_binary_identity \
    "${current_executor}" autostream-local-executor "${expected_pair}")" || return 1
  [[ ${second_agent_identity} == "${first_agent_identity}" &&
    ${second_executor_identity} == "${first_executor_identity}" &&
    ${second_agent_identity} == "${second_executor_identity}" ]] || return 1
  if [[ ${expected_pair} == verified-candidate ]]; then
    active_job_recovery_verified_candidate_sources_are_intact || return 1
    [[ $(sha256sum -- "${current_agent}" | awk 'NR == 1 { print $1 }') == \
        "${first_agent_sha256}" &&
      $(sha256sum -- "${current_executor}" | awk 'NR == 1 { print $1 }') == \
        "${first_executor_sha256}" ]] || return 1
  fi
  executor_second_pid="$(${SYSTEMCTL_PATH} show \
    "${LOCAL_EXECUTOR_SERVICE_NAME}" --property=MainPID --value 2>/dev/null)" || \
    return 1
  [[ ${executor_second_pid} == "${executor_first_pid}" ]] || return 1
  executor_second_executable="$(readlink -f -- \
    "/proc/${executor_second_pid}/exe")" || return 1
  [[ ${executor_second_executable} == "${current_executor}" ]] || return 1

  if [[ -z ${active_job_recovery_original_current_target} ]]; then
    active_job_recovery_original_current_target=${current_target}
    active_job_recovery_original_agent_identity=${second_agent_identity}
    active_job_recovery_original_agent_stat=${first_agent_stat}
    active_job_recovery_original_agent_sha256="$(sha256sum -- \
      "${current_agent}" | awk 'NR == 1 { print $1 }')" || return 1
    active_job_recovery_original_executor_identity=${second_executor_identity}
    active_job_recovery_original_executor_stat=${first_executor_stat}
    active_job_recovery_original_executor_sha256="$(sha256sum -- \
      "${current_executor}" | awk 'NR == 1 { print $1 }')" || return 1
  fi
}

active_job_recovery_original_pair_is_intact() {
  local current_agent
  local current_executor
  local current_target
  local agent_identity
  local executor_identity
  [[ -n ${active_job_recovery_original_current_target} &&
    -n ${active_job_recovery_original_agent_identity} &&
    -n ${active_job_recovery_original_agent_stat} &&
    ${active_job_recovery_original_agent_sha256} =~ ^[0-9a-f]{64}$ &&
    -n ${active_job_recovery_original_executor_identity} &&
    -n ${active_job_recovery_original_executor_stat} &&
    ${active_job_recovery_original_executor_sha256} =~ ^[0-9a-f]{64}$ ]] || return 1
  active_job_recovery_live_pair_is_managed || return 1
  current_target="$(readlink -- "${HOST_RUNTIME_CURRENT}")" || return 1
  [[ ${current_target} == "${active_job_recovery_original_current_target}" ]] || return 1
  current_agent="$(readlink -f -- \
    "${HOST_RUNTIME_CURRENT}/bin/autostream-host-agent")" || return 1
  current_executor="$(readlink -f -- \
    "${HOST_RUNTIME_CURRENT}/bin/autostream-local-executor")" || return 1
  [[ $(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- "${current_agent}") == \
      "${active_job_recovery_original_agent_stat}" &&
    $(sha256sum -- "${current_agent}" | awk 'NR == 1 { print $1 }') == \
      "${active_job_recovery_original_agent_sha256}" &&
    $(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- "${current_executor}") == \
      "${active_job_recovery_original_executor_stat}" &&
    $(sha256sum -- "${current_executor}" | awk 'NR == 1 { print $1 }') == \
      "${active_job_recovery_original_executor_sha256}" ]] || return 1
  agent_identity="$(read_active_job_recovery_binary_identity \
    "${current_agent}" autostream-host-agent rescue-source)" || return 1
  executor_identity="$(read_active_job_recovery_binary_identity \
    "${current_executor}" autostream-local-executor rescue-source)" || return 1
  [[ ${agent_identity} == "${active_job_recovery_original_agent_identity}" &&
    ${executor_identity} == "${active_job_recovery_original_executor_identity}" &&
    ${agent_identity} == "${executor_identity}" ]]
}

active_job_recovery_service_is_inactive() {
  local active_state
  local main_pid
  active_state="$(${SYSTEMCTL_PATH} show "${UNIT_NAME}" --property=ActiveState --value 2>/dev/null)" || return 1
  main_pid="$(${SYSTEMCTL_PATH} show "${UNIT_NAME}" --property=MainPID --value 2>/dev/null)" || return 1
  [[ ${active_state} == "inactive" && ${main_pid} == "0" ]]
}

active_job_recovery_guard_candidate_is_intact() {
  [[ -n ${active_job_recovery_guard_candidate_dir} &&
    ${active_job_recovery_guard_candidate_dir} == \
      "${ACTIVE_JOB_RECOVERY_GUARD_CANDIDATE_PREFIX}"* &&
    -d ${active_job_recovery_guard_candidate_dir} &&
    ! -L ${active_job_recovery_guard_candidate_dir} &&
    $(readlink -f -- "${active_job_recovery_guard_candidate_dir}") == \
      "${active_job_recovery_guard_candidate_dir}" &&
    $(stat -c '%U:%G:%a' -- "${active_job_recovery_guard_candidate_dir}") == \
      "root:root:700" &&
    $(stat -c '%d:%i' -- "${active_job_recovery_guard_candidate_dir}") == \
      "${active_job_recovery_guard_candidate_dir_identity}" &&
    ${active_job_recovery_guard_candidate_path} == \
      "${active_job_recovery_guard_candidate_dir}/autostream-local-executor" &&
    -f ${active_job_recovery_guard_candidate_path} &&
    ! -L ${active_job_recovery_guard_candidate_path} &&
    $(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- \
      "${active_job_recovery_guard_candidate_path}") == \
      "${active_job_recovery_guard_candidate_identity}" &&
    $(stat -c '%U:%G:%a:%h' -- \
      "${active_job_recovery_guard_candidate_path}") == "root:root:700:1" &&
    $(sha256sum -- "${active_job_recovery_guard_candidate_path}" |
      awk 'NR == 1 { print $1 }') == \
      "${active_job_recovery_guard_candidate_sha256}" ]]
}

prepare_active_job_recovery_guard_candidate() {
  local source_identity
  local source_sha256
  validate_root_parent_chain "/run/autostream-host-agent-upgrade-guard.placeholder" \
    "Host Agent delayed recovery guard"
  source_identity="$(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- \
    "${LOCAL_EXECUTOR_BINARY_SOURCE}")" || \
    die "could not record the delayed recovery Executor source identity"
  source_sha256="$(sha256sum -- "${LOCAL_EXECUTOR_BINARY_SOURCE}" |
    awk 'NR == 1 { print $1 }')" || \
    die "could not hash the delayed recovery Executor source"
  [[ ${source_sha256} == "${VERIFIED_EXECUTOR_SOURCE_SHA256}" ]] || \
    die "delayed recovery Executor source differs from the verified bundle"

  defer_cleanup_signals
  active_job_recovery_guard_candidate_dir="$(
    mktemp -d "${ACTIVE_JOB_RECOVERY_GUARD_CANDIDATE_PREFIX}XXXXXXXX"
  )" || die "could not create the delayed recovery guard directory"
  resume_cleanup_signals || \
    die "installation was interrupted while creating the delayed recovery guard"
  active_job_recovery_guard_candidate_path="${active_job_recovery_guard_candidate_dir}/autostream-local-executor"
  install -o root -g root -m 0700 \
    "${LOCAL_EXECUTOR_BINARY_SOURCE}" \
    "${active_job_recovery_guard_candidate_path}"
  sync -f "${active_job_recovery_guard_candidate_path}"
  sync -f "${active_job_recovery_guard_candidate_dir}"
  [[ -f ${LOCAL_EXECUTOR_BINARY_SOURCE} &&
    ! -L ${LOCAL_EXECUTOR_BINARY_SOURCE} &&
    $(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- \
      "${LOCAL_EXECUTOR_BINARY_SOURCE}") == "${source_identity}" &&
    $(sha256sum -- "${LOCAL_EXECUTOR_BINARY_SOURCE}" |
      awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "verified delayed recovery Executor source changed while copying"
  active_job_recovery_guard_candidate_dir_identity="$(stat -c '%d:%i' -- \
    "${active_job_recovery_guard_candidate_dir}")" || \
    die "could not record the delayed recovery guard directory identity"
  active_job_recovery_guard_candidate_identity="$(
    stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- \
      "${active_job_recovery_guard_candidate_path}"
  )" || die "could not record the delayed recovery guard identity"
  active_job_recovery_guard_candidate_sha256=${source_sha256}
  active_job_recovery_guard_candidate_is_intact || \
    die "delayed recovery guard candidate is unsafe"
}

active_job_recovery_clear_fence_is_intact() {
  local expected_content
  expected_content="$(printf '%s\n' \
    '[Unit]' \
    "ConditionPathExists=!${ACTIVE_JOB_RECOVERY_CLEAR_MARKER}" \
    "ConditionFileIsExecutable=${active_job_recovery_guard_candidate_path}")"
  [[ ${active_job_recovery_clear_fence_installed} == true &&
    -f ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE} &&
    ! -L ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE} &&
    $(readlink -f -- "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}") == \
      "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}" &&
    $(stat -c '%U:%G:%a:%h' -- "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}") == \
      "root:root:644:1" &&
    $(stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- \
      "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}") == \
      "${active_job_recovery_clear_fence_identity}" &&
    $(sha256sum -- "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}" |
      awk 'NR == 1 { print $1 }') == \
      "${active_job_recovery_clear_fence_sha256}" &&
    $(<"${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}") == "${expected_content}" ]]
}

active_job_recovery_clear_fence_is_loaded() {
  local drop_in
  local drop_ins
  drop_ins="$(${SYSTEMCTL_PATH} show "${UNIT_NAME}" \
    --property=DropInPaths --value 2>/dev/null)" || return 1
  for drop_in in ${drop_ins}; do
    [[ ${drop_in} == "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}" ]] && return 0
  done
  return 1
}

install_active_job_recovery_clear_fence() {
  local temporary_fence
  [[ ! -e ${ACTIVE_JOB_RECOVERY_CLEAR_MARKER} &&
    ! -L ${ACTIVE_JOB_RECOVERY_CLEAR_MARKER} ]] || \
    die "Host Agent journal clear fence already blocks legacy Agent restart"
  active_job_recovery_guard_candidate_is_intact || \
    die "delayed recovery guard candidate changed before fence installation"
  validate_root_parent_chain "${UNIT_DEST}" "Host Agent recovery drop-in"
  if [[ -e ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR} ||
    -L ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR} ]]; then
    [[ -d ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR} &&
      ! -L ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR} &&
      $(readlink -f -- "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR}") == \
        "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR}" &&
      $(stat -c '%U:%G:%a' -- "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR}") == \
        "root:root:755" ]] || \
      die "Host Agent recovery drop-in directory is unsafe"
  else
    install -d -o root -g root -m 0755 \
      "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR}"
    sync -f "$(dirname -- "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR}")"
  fi
  [[ ! -e ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE} &&
    ! -L ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE} ]] || \
    die "Host Agent delayed recovery fence already exists"
  temporary_fence="$(mktemp \
    "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR}/.90-autostream-upgrade-recovery-guard.XXXXXXXX")" || \
    die "could not create the Host Agent delayed recovery fence"
  printf '%s\n' \
    '[Unit]' \
    "ConditionPathExists=!${ACTIVE_JOB_RECOVERY_CLEAR_MARKER}" \
    "ConditionFileIsExecutable=${active_job_recovery_guard_candidate_path}" \
    >"${temporary_fence}"
  chown root:root "${temporary_fence}"
  chmod 0644 "${temporary_fence}"
  sync -f "${temporary_fence}"
  mv -- "${temporary_fence}" "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}"
  active_job_recovery_clear_fence_installed=true
  active_job_recovery_clear_fence_identity="$(
    stat -c '%d:%i:%s:%Y:%f:%u:%g:%a:%h' -- \
      "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}"
  )" || die "could not record the Host Agent delayed recovery fence identity"
  active_job_recovery_clear_fence_sha256="$(sha256sum -- \
    "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}" | awk 'NR == 1 { print $1 }')" || \
    die "could not hash the Host Agent delayed recovery fence"
  sync -f "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR}"
  active_job_recovery_clear_fence_is_intact || \
    die "Host Agent delayed recovery fence is unsafe"
  ${SYSTEMCTL_PATH} daemon-reload
  [[ $(${SYSTEMCTL_PATH} show "${UNIT_NAME}" \
    --property=NeedDaemonReload --value 2>/dev/null) == "no" ]] || \
    die "systemd did not load the Host Agent delayed recovery fence"
  active_job_recovery_clear_fence_is_loaded || \
    die "systemd did not report the Host Agent delayed recovery fence"
  [[ ! -e ${ACTIVE_JOB_RECOVERY_CLEAR_MARKER} &&
    ! -L ${ACTIVE_JOB_RECOVERY_CLEAR_MARKER} ]] || \
    die "Host Agent journal clear fence appeared before service stop"
}

active_job_recovery_guard_unit_load_state() {
  local unit=$1
  ${SYSTEMCTL_PATH} show "${unit}" --property=LoadState --value 2>/dev/null
}

active_job_recovery_guard_unit_is_absent() {
  local unit=$1
  local path=$2
  local load_state
  load_state="$(active_job_recovery_guard_unit_load_state "${unit}")" || return 1
  [[ ${load_state} == "not-found" && ! -e ${path} && ! -L ${path} ]]
}

validate_active_job_recovery_guard_fragment() {
  local unit=$1
  local path=$2
  local fragment_path
  local mode
  [[ -f ${path} && ! -L ${path} &&
    $(readlink -f -- "${path}") == "${path}" &&
    $(stat -c '%U:%G:%h' -- "${path}") == "root:root:1" ]] || \
    return 1
  mode=$(stat -c '%a' -- "${path}") || return 1
  (( (8#${mode} & 0022) == 0 )) || return 1
  fragment_path="$(${SYSTEMCTL_PATH} show "${unit}" --property=FragmentPath --value 2>/dev/null)" || \
    return 1
  [[ ${fragment_path} == "${path}" ]]
}

arm_active_job_recovery_guard() {
  local expected_slot
  local timer_state
  [[ ${active_job_recovery_original_current_target} == "slots/a" ||
    ${active_job_recovery_original_current_target} == "slots/b" ]] || \
    die "pre-stop Host runtime slot is unavailable for the recovery guard"
  expected_slot=${active_job_recovery_original_current_target#slots/}
  active_job_recovery_guard_candidate_is_intact || \
    die "delayed recovery guard candidate changed before timer activation"
  active_job_recovery_clear_fence_is_intact || \
    die "Host Agent delayed recovery fence changed before timer activation"
  active_job_recovery_clear_fence_is_loaded || \
    die "Host Agent delayed recovery fence is not loaded"
  [[ ! -e ${ACTIVE_JOB_RECOVERY_CLEAR_MARKER} &&
    ! -L ${ACTIVE_JOB_RECOVERY_CLEAR_MARKER} ]] || \
    die "Host Agent journal clear fence blocks recovery guard activation"
  active_job_recovery_guard_unit_is_absent \
    "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE}" \
    "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE_PATH}" || \
    die "Host Agent recovery guard service already exists or is unsafe"
  active_job_recovery_guard_unit_is_absent \
    "${ACTIVE_JOB_RECOVERY_GUARD_TIMER}" \
    "${ACTIVE_JOB_RECOVERY_GUARD_TIMER_PATH}" || \
    die "Host Agent recovery guard timer already exists or is unsafe"

  if ! ${SYSTEMD_RUN_PATH} \
    --quiet \
    --collect \
    --unit="${ACTIVE_JOB_RECOVERY_GUARD_BASE}" \
    --on-active="${ACTIVE_JOB_RECOVERY_GUARD_DELAY}" \
    --timer-property=AccuracySec=1s \
    "${active_job_recovery_guard_candidate_path}" \
      guard-restart-host-agent \
      --expected-slot "${expected_slot}" \
      --agent-sha256 "${active_job_recovery_original_agent_sha256}" \
      --executor-sha256 "${active_job_recovery_original_executor_sha256}"; then
    if ! active_job_recovery_guard_unit_is_absent \
      "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE}" \
      "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE_PATH}" || \
      ! active_job_recovery_guard_unit_is_absent \
        "${ACTIVE_JOB_RECOVERY_GUARD_TIMER}" \
        "${ACTIVE_JOB_RECOVERY_GUARD_TIMER_PATH}"; then
      active_job_recovery_guard_armed=true
    fi
    die "could not arm the Host Agent recovery guard"
  fi
  active_job_recovery_guard_armed=true
  validate_active_job_recovery_guard_fragment \
    "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE}" \
    "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE_PATH}" || \
    die "Host Agent recovery guard service identity is unsafe"
  validate_active_job_recovery_guard_fragment \
    "${ACTIVE_JOB_RECOVERY_GUARD_TIMER}" \
    "${ACTIVE_JOB_RECOVERY_GUARD_TIMER_PATH}" || \
    die "Host Agent recovery guard timer identity is unsafe"
  timer_state="$(${SYSTEMCTL_PATH} is-active "${ACTIVE_JOB_RECOVERY_GUARD_TIMER}" 2>/dev/null)" || \
    die "Host Agent recovery guard timer did not become active"
  [[ ${timer_state} == "active" ]] || \
    die "Host Agent recovery guard timer did not become active"
}

disarm_active_job_recovery_guard() {
  local attempt
  local load_state
  local active_state
  [[ ${active_job_recovery_guard_armed} == true ]] || return 0
  active_job_recovery_service_is_managed || {
    printf '%s\n' \
      'install-autostream-host-agent: refusing to disarm the recovery guard before the Host Agent is active' >&2
    return 1
  }
  load_state="$(active_job_recovery_guard_unit_load_state \
    "${ACTIVE_JOB_RECOVERY_GUARD_TIMER}")" || return 1
  if [[ ${load_state} != "not-found" ]]; then
    ${SYSTEMCTL_PATH} stop "${ACTIVE_JOB_RECOVERY_GUARD_TIMER}" >/dev/null || return 1
  fi
  load_state="$(active_job_recovery_guard_unit_load_state \
    "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE}")" || return 1
  if [[ ${load_state} != "not-found" ]]; then
    ${SYSTEMCTL_PATH} stop "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE}" >/dev/null || return 1
  fi
  active_state="$(${SYSTEMCTL_PATH} show \
    "${ACTIVE_JOB_RECOVERY_GUARD_TIMER}" --property=ActiveState --value 2>/dev/null)" || \
    return 1
  [[ ${active_state} == "inactive" ]] || return 1
  for attempt in {1..40}; do
    if active_job_recovery_guard_unit_is_absent \
      "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE}" \
      "${ACTIVE_JOB_RECOVERY_GUARD_SERVICE_PATH}" && \
      active_job_recovery_guard_unit_is_absent \
        "${ACTIVE_JOB_RECOVERY_GUARD_TIMER}" \
        "${ACTIVE_JOB_RECOVERY_GUARD_TIMER_PATH}"; then
      active_job_recovery_guard_armed=false
      return 0
    fi
    sleep 0.05
  done
  printf '%s\n' \
    'install-autostream-host-agent: systemd did not collect the recovery guard units' >&2
  return 1
}

remove_active_job_recovery_clear_fence() {
  [[ ${active_job_recovery_clear_fence_installed} == true ]] || return 0
  active_job_recovery_service_is_managed || return 1
  [[ ! -e ${ACTIVE_JOB_RECOVERY_CLEAR_MARKER} &&
    ! -L ${ACTIVE_JOB_RECOVERY_CLEAR_MARKER} ]] || return 1
  active_job_recovery_guard_candidate_is_intact || return 1
  active_job_recovery_clear_fence_is_intact || return 1
  active_job_recovery_clear_fence_is_loaded || return 1
  rm -f -- "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE}" || return 1
  sync -f "${ACTIVE_JOB_RECOVERY_CLEAR_FENCE_DIR}" || return 1
  ${SYSTEMCTL_PATH} daemon-reload || return 1
  [[ $(${SYSTEMCTL_PATH} show "${UNIT_NAME}" \
    --property=NeedDaemonReload --value 2>/dev/null) == "no" ]] || return 1
  if active_job_recovery_clear_fence_is_loaded; then
    return 1
  fi
  [[ ! -e ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE} &&
    ! -L ${ACTIVE_JOB_RECOVERY_CLEAR_FENCE} ]] || return 1
  active_job_recovery_clear_fence_installed=false
  active_job_recovery_clear_fence_identity=""
  active_job_recovery_clear_fence_sha256=""
}

cleanup_active_job_recovery_guard_candidate() {
  [[ -n ${active_job_recovery_guard_candidate_dir} ]] || return 0
  if [[ ${active_job_recovery_guard_armed} == true ||
    ${active_job_recovery_clear_fence_installed} == true ]]; then
    return 0
  fi
  active_job_recovery_guard_candidate_is_intact || {
    printf '%s\n' \
      'install-autostream-host-agent: refusing to remove a changed delayed recovery guard path' >&2
    return 1
  }
  rm -f -- "${active_job_recovery_guard_candidate_path}" || return 1
  rmdir -- "${active_job_recovery_guard_candidate_dir}" || return 1
  active_job_recovery_guard_candidate_path=""
  active_job_recovery_guard_candidate_identity=""
  active_job_recovery_guard_candidate_sha256=""
  active_job_recovery_guard_candidate_dir=""
  active_job_recovery_guard_candidate_dir_identity=""
}

cleanup_active_job_recovery_candidate() {
  [[ -n ${active_job_recovery_candidate_dir} ]] || return 0
  [[ ${active_job_recovery_candidate_dir} == \
      /run/autostream-host-agent-recovery.* &&
    -d ${active_job_recovery_candidate_dir} &&
    ! -L ${active_job_recovery_candidate_dir} &&
    $(stat -c '%d:%i' -- "${active_job_recovery_candidate_dir}") == \
      "${active_job_recovery_candidate_dir_identity}" &&
    ${active_job_recovery_candidate_path} == \
      "${active_job_recovery_candidate_dir}/autostream-host-agent" &&
    -f ${active_job_recovery_candidate_path} &&
    ! -L ${active_job_recovery_candidate_path} &&
    $(stat -c '%d:%i:%s:%u:%g:%a:%h' -- \
      "${active_job_recovery_candidate_path}") == \
      "${active_job_recovery_candidate_identity}" &&
    $(sha256sum -- "${active_job_recovery_candidate_path}" | awk 'NR == 1 { print $1 }') == \
      "${active_job_recovery_candidate_sha256}" &&
    $(stat -c '%U:%G:%a' -- "${active_job_recovery_candidate_dir}") == \
      "root:${AGENT_GROUP}:750" ]] || {
    printf '%s\n' \
      'install-autostream-host-agent: refusing to remove a changed Host Agent recovery candidate path' >&2
    return 1
  }
  rm -f -- "${active_job_recovery_candidate_path}" || return 1
  rmdir -- "${active_job_recovery_candidate_dir}" || return 1
  active_job_recovery_candidate_path=""
  active_job_recovery_candidate_identity=""
  active_job_recovery_candidate_sha256=""
  active_job_recovery_candidate_dir=""
  active_job_recovery_candidate_dir_identity=""
}

cleanup_active_job_recovery() {
  local cleanup_failed=false
  if [[ ${active_job_recovery_stop_attempted} == true ||
    ${active_job_recovery_clear_fence_installed} == true ||
    ${active_job_recovery_guard_armed} == true ]]; then
    if ! reacquire_active_job_recovery_cleanup_locks; then
      printf '%s\n' \
        'install-autostream-host-agent: could not reacquire the canonical Host setup and lifecycle locks; the durable recovery fence and systemd guard were retained' >&2
      cleanup_failed=true
    elif [[ ${active_job_recovery_stop_attempted} == true &&
      ${active_job_recovery_upgrade_committed} == false ]] &&
      ! active_job_recovery_original_pair_is_intact; then
      printf '%s\n' \
        'install-autostream-host-agent: the pre-stop Host runtime pair was not restored; the durable recovery fence and systemd guard were retained' >&2
      cleanup_failed=true
    elif [[ ${active_job_recovery_stop_attempted} == true &&
      ${active_job_recovery_upgrade_committed} == true ]] &&
      ! active_job_recovery_live_pair_is_managed verified-candidate; then
      printf '%s\n' \
        'install-autostream-host-agent: the committed Host runtime pair is not safely managed; the durable recovery fence and systemd guard were retained' >&2
      cleanup_failed=true
    else
      if ! active_job_recovery_service_is_managed; then
        if ! ${SYSTEMCTL_PATH} start "${UNIT_NAME}" >/dev/null 2>&1 ||
          ! active_job_recovery_service_is_managed; then
          printf '%s\n' \
            'install-autostream-host-agent: Host Agent recovery failed and the exact runtime could not be restarted; the durable recovery fence and systemd guard were retained' >&2
          cleanup_failed=true
        fi
      fi
      if [[ ${cleanup_failed} == false &&
        ${active_job_recovery_upgrade_committed} == false ]] &&
        ! active_job_recovery_original_pair_is_intact; then
        printf '%s\n' \
          'install-autostream-host-agent: the restarted Host Agent no longer matches the pre-stop runtime pair; the durable recovery fence and systemd guard were retained' >&2
        cleanup_failed=true
      fi
      if [[ ${cleanup_failed} == false &&
        ${active_job_recovery_upgrade_committed} == true ]] &&
        ! active_job_recovery_live_pair_is_managed verified-candidate; then
        printf '%s\n' \
          'install-autostream-host-agent: the active Host Agent no longer matches the committed runtime pair; the durable recovery fence and systemd guard were retained' >&2
        cleanup_failed=true
      fi
    fi
    if [[ ${active_job_recovery_clear_fence_installed} == true &&
      ${cleanup_failed} == false ]] &&
      ! remove_active_job_recovery_clear_fence; then
      printf '%s\n' \
        'install-autostream-host-agent: Host Agent is active but the durable recovery fence could not be removed' >&2
      cleanup_failed=true
    fi
    if [[ ${active_job_recovery_guard_armed} == true &&
      ${cleanup_failed} == false ]] &&
      ! disarm_active_job_recovery_guard; then
      printf '%s\n' \
        'install-autostream-host-agent: Host Agent is active but the recovery guard could not be disarmed' >&2
      cleanup_failed=true
    fi
    if [[ ${cleanup_failed} == false &&
      ${active_job_recovery_clear_fence_installed} == false &&
      ${active_job_recovery_guard_armed} == false ]]; then
      active_job_recovery_stop_attempted=false
    fi
  fi
  if ! cleanup_active_job_recovery_candidate; then
    cleanup_failed=true
  fi
  if ! cleanup_active_job_recovery_guard_candidate; then
    cleanup_failed=true
  fi
  if ! release_active_job_recovery_locks; then
    cleanup_failed=true
  fi
  [[ ${cleanup_failed} == false ]]
}

acquire_active_job_recovery_locks() {
  acquire_shared_host_setup_lock
  active_job_recovery_setup_lock_held=true
  active_job_recovery_lock_dir_identity="$(
    stat -c '%d:%i' -- "${SHARED_HOST_SETUP_LOCK_DIR}"
  )" || die "could not record the active-job recovery lock directory identity"
  acquire_host_lifecycle_lock
  active_job_recovery_lifecycle_lock_held=true
}

active_job_recovery_root_parent_chain_is_safe() {
  local path=$1
  local current
  local mode
  local owner
  local parent
  current="$(dirname -- "${path}")" || return 1
  while true; do
    [[ -d ${current} && ! -L ${current} ]] || return 1
    owner="$(stat -c '%U:%G' -- "${current}")" || return 1
    [[ ${owner} == "root:root" ]] || return 1
    mode="$(stat -c '%a' -- "${current}")" || return 1
    [[ ${mode} =~ ^[0-7]{3,4}$ ]] || return 1
    (( (8#${mode} & 0022) == 0 )) || return 1
    parent="$(dirname -- "${current}")" || return 1
    [[ ${parent} == "${current}" ]] && break
    current=${parent}
  done
}

active_job_recovery_lock_directory_is_stable() {
  local directory_identity
  [[ -n ${active_job_recovery_lock_dir_identity} ]] || return 1
  active_job_recovery_root_parent_chain_is_safe \
    "${HOST_LIFECYCLE_LOCK}" || return 1
  [[ -d ${SHARED_HOST_SETUP_LOCK_DIR} &&
    ! -L ${SHARED_HOST_SETUP_LOCK_DIR} ]] || return 1
  [[ $(readlink -f -- "${SHARED_HOST_SETUP_LOCK_DIR}") == \
    "${SHARED_HOST_SETUP_LOCK_DIR}" ]] || return 1
  [[ $(stat -c '%U:%G:%a' -- "${SHARED_HOST_SETUP_LOCK_DIR}") == \
    "root:root:700" ]] || return 1
  directory_identity="$(stat -c '%d:%i' -- \
    "${SHARED_HOST_SETUP_LOCK_DIR}")" || return 1
  [[ ${directory_identity} == "${active_job_recovery_lock_dir_identity}" ]]
}

active_job_recovery_lock_path_is_safe() {
  local path=$1
  [[ -f ${path} && ! -L ${path} ]] || return 1
  [[ $(readlink -f -- "${path}") == "${path}" ]] || return 1
  [[ $(stat -c '%U:%G:%a:%h' -- "${path}") == \
    "root:root:600:1" ]]
}

active_job_recovery_lock_fd_matches_path() {
  local descriptor=$1
  local path=$2
  local fd_path="/proc/self/fd/${descriptor}"
  local fd_identity
  local path_identity
  [[ -f ${fd_path} ]] || return 1
  [[ $(stat -Lc '%U:%G:%a:%h' -- "${fd_path}") == \
    "root:root:600:1" ]] || return 1
  fd_identity="$(stat -Lc '%d:%i' -- "${fd_path}")" || return 1
  path_identity="$(stat -c '%d:%i' -- "${path}")" || return 1
  [[ ${fd_identity} == "${path_identity}" ]]
}

try_reacquire_active_job_recovery_setup_lock() {
  if [[ ${active_job_recovery_setup_lock_held} == true ]]; then
    return 0
  fi
  [[ ${active_job_recovery_lifecycle_lock_held} == false ]] || return 1
  active_job_recovery_lock_directory_is_stable || return 1
  active_job_recovery_lock_path_is_safe "${SHARED_HOST_SETUP_LOCK}" || return 1
  # Read-only open avoids creating or truncating permanent coordination state
  # during best-effort cleanup. flock(2) does not require a writable descriptor.
  exec 8<"${SHARED_HOST_SETUP_LOCK}" || return 1
  if ! active_job_recovery_lock_directory_is_stable ||
    ! active_job_recovery_lock_path_is_safe "${SHARED_HOST_SETUP_LOCK}" ||
    ! active_job_recovery_lock_fd_matches_path 8 "${SHARED_HOST_SETUP_LOCK}"; then
    exec 8>&-
    return 1
  fi
  if ! flock -n 8; then
    exec 8>&-
    return 1
  fi
  if ! active_job_recovery_lock_directory_is_stable ||
    ! active_job_recovery_lock_path_is_safe "${SHARED_HOST_SETUP_LOCK}" ||
    ! active_job_recovery_lock_fd_matches_path 8 "${SHARED_HOST_SETUP_LOCK}"; then
    flock -u 8 >/dev/null 2>&1 || true
    exec 8>&-
    return 1
  fi
  active_job_recovery_setup_lock_held=true
}

try_reacquire_active_job_recovery_lifecycle_lock() {
  if [[ ${active_job_recovery_lifecycle_lock_held} == true ]]; then
    [[ ${active_job_recovery_setup_lock_held} == true ]] || return 1
    return 0
  fi
  [[ ${active_job_recovery_setup_lock_held} == true ]] || return 1
  active_job_recovery_lock_directory_is_stable || return 1
  active_job_recovery_lock_path_is_safe "${HOST_LIFECYCLE_LOCK}" || return 1
  exec 9<"${HOST_LIFECYCLE_LOCK}" || return 1
  if ! active_job_recovery_lock_directory_is_stable ||
    ! active_job_recovery_lock_path_is_safe "${HOST_LIFECYCLE_LOCK}" ||
    ! active_job_recovery_lock_fd_matches_path 9 "${HOST_LIFECYCLE_LOCK}"; then
    exec 9>&-
    return 1
  fi
  if ! flock -n 9; then
    exec 9>&-
    return 1
  fi
  if ! active_job_recovery_lock_directory_is_stable ||
    ! active_job_recovery_lock_path_is_safe "${HOST_LIFECYCLE_LOCK}" ||
    ! active_job_recovery_lock_fd_matches_path 9 "${HOST_LIFECYCLE_LOCK}"; then
    flock -u 9 >/dev/null 2>&1 || true
    exec 9>&-
    return 1
  fi
  active_job_recovery_lifecycle_lock_held=true
}

reacquire_active_job_recovery_cleanup_locks() {
  try_reacquire_active_job_recovery_setup_lock || return 1
  try_reacquire_active_job_recovery_lifecycle_lock
}

release_active_job_recovery_lifecycle_lock() {
  local release_failed=false
  [[ ${active_job_recovery_lifecycle_lock_held} == true ]] || return 0
  flock -u 9 || release_failed=true
  exec 9>&-
  # Closing the descriptor releases its lock even if the explicit unlock
  # command reported an error. Never retry against a recycled descriptor.
  active_job_recovery_lifecycle_lock_held=false
  if [[ ${release_failed} == true ]]; then
    printf '%s\n' \
      'install-autostream-host-agent: could not release the active-job lifecycle lock' >&2
    return 1
  fi
}

reacquire_active_job_recovery_lifecycle_lock() {
  [[ ${active_job_recovery_setup_lock_held} == true &&
    ${active_job_recovery_lifecycle_lock_held} == false ]] || \
    die "active-job recovery lock state is invalid"
  try_reacquire_active_job_recovery_lifecycle_lock || \
    die "another privileged Host lifecycle operation is active after exact active job recovery"
}

release_active_job_recovery_setup_lock() {
  local release_failed=false
  [[ ${active_job_recovery_setup_lock_held} == true ]] || return 0
  flock -u 8 || release_failed=true
  exec 8>&-
  active_job_recovery_setup_lock_held=false
  if [[ ${release_failed} == true ]]; then
    printf '%s\n' \
      'install-autostream-host-agent: could not release the active-job setup lock' >&2
    return 1
  fi
}

release_active_job_recovery_locks() {
  local release_failed=false
  release_active_job_recovery_lifecycle_lock || release_failed=true
  release_active_job_recovery_setup_lock || release_failed=true
  [[ ${release_failed} == false ]]
}

prepare_active_job_recovery_candidate() {
  local agent_gid
  local agent_uid
  local source_identity
  local source_sha256
  agent_uid="$(id -u "${AGENT_USER}")" || \
    die "Host Agent service account is unavailable"
  agent_gid="$(getent group "${AGENT_GROUP}" | awk -F: 'NR == 1 { print $3 }')" || \
    die "Host Agent service group is unavailable"
  [[ ${agent_uid} =~ ^[1-9][0-9]*$ &&
    ${agent_gid} =~ ^[1-9][0-9]*$ ]] || \
    die "Host Agent service account identity is unsafe"
  validate_root_parent_chain "/run/autostream-host-agent-recovery.placeholder" \
    "Host Agent recovery candidate"
  [[ -d ${CONFIG_DIR} && ! -L ${CONFIG_DIR} &&
    $(readlink -f -- "${CONFIG_DIR}") == "${CONFIG_DIR}" &&
    $(stat -c '%U:%G:%a' -- "${CONFIG_DIR}") == \
      "root:${AGENT_GROUP}:750" ]] || \
    die "canonical Host Agent identity directory is unsafe"
  [[ -f ${CONFIG_DEST} && ! -L ${CONFIG_DEST} &&
    $(readlink -f -- "${CONFIG_DEST}") == "${CONFIG_DEST}" &&
    $(stat -c '%U:%G:%a:%h' -- "${CONFIG_DEST}") == \
      "root:${AGENT_GROUP}:640:1" ]] || \
    die "canonical Host Agent identity is unsafe"
  ${RUNUSER_PATH} --user "${AGENT_USER}" -- test -r "${CONFIG_DEST}" || \
    die "Host Agent service account cannot read the canonical identity"

  defer_cleanup_signals
  active_job_recovery_candidate_dir="$(
    mktemp -d /run/autostream-host-agent-recovery.XXXXXXXX
  )" || die "could not create the Host Agent recovery candidate directory"
  resume_cleanup_signals || \
    die "installation was interrupted while creating the recovery candidate directory"
  [[ -n ${active_job_recovery_candidate_dir} &&
    ${active_job_recovery_candidate_dir} == \
      /run/autostream-host-agent-recovery.* &&
    -d ${active_job_recovery_candidate_dir} &&
    ! -L ${active_job_recovery_candidate_dir} &&
    $(readlink -f -- "${active_job_recovery_candidate_dir}") == \
      "${active_job_recovery_candidate_dir}" &&
    $(stat -c '%U:%G:%a' -- "${active_job_recovery_candidate_dir}") == \
      "root:root:700" ]] || \
    die "Host Agent recovery candidate directory is unsafe"
  chown "root:${AGENT_GROUP}" "${active_job_recovery_candidate_dir}"
  chmod 0750 "${active_job_recovery_candidate_dir}"
  [[ $(stat -c '%U:%G:%a' -- "${active_job_recovery_candidate_dir}") == \
    "root:${AGENT_GROUP}:750" ]] || \
    die "Host Agent recovery candidate directory metadata is unsafe"
  active_job_recovery_candidate_dir_identity="$(
    stat -c '%d:%i' -- "${active_job_recovery_candidate_dir}"
  )" || die "could not record the recovery candidate directory identity"
  active_job_recovery_candidate_path="${active_job_recovery_candidate_dir}/autostream-host-agent"
  source_identity="$(stat -c '%d:%i:%s:%Y:%f' -- "${BINARY_SOURCE}")"
  source_sha256="$(sha256sum -- "${BINARY_SOURCE}" | awk 'NR == 1 { print $1 }')"
  install -o root -g "${AGENT_GROUP}" -m 0750 \
    "${BINARY_SOURCE}" "${active_job_recovery_candidate_path}"
  [[ -f ${BINARY_SOURCE} && ! -L ${BINARY_SOURCE} &&
    $(stat -c '%d:%i:%s:%Y:%f' -- "${BINARY_SOURCE}") == \
      "${source_identity}" &&
    $(sha256sum -- "${BINARY_SOURCE}" | awk 'NR == 1 { print $1 }') == \
      "${source_sha256}" &&
    -f ${active_job_recovery_candidate_path} &&
    ! -L ${active_job_recovery_candidate_path} &&
    $(sha256sum -- "${active_job_recovery_candidate_path}" | awk 'NR == 1 { print $1 }') == \
      "${source_sha256}" &&
    $(stat -c '%U:%G:%a:%h' -- "${active_job_recovery_candidate_path}") == \
      "root:${AGENT_GROUP}:750:1" ]] || \
    die "Host Agent recovery candidate copy is unsafe"
  active_job_recovery_candidate_identity="$(
    stat -c '%d:%i:%s:%u:%g:%a:%h' -- "${active_job_recovery_candidate_path}"
  )" || die "could not record the recovery candidate identity"
  active_job_recovery_candidate_sha256="${source_sha256}"
}

manual_upgrade_candidate_pid=""
manual_upgrade_wait_signal=""
manual_upgrade_pending_signal=""

manual_upgrade_candidate_is_child_job() {
  local job_pid
  while IFS= read -r job_pid; do
    [[ ${job_pid} == "${manual_upgrade_candidate_pid}" ]] && return 0
  done < <(jobs -p)
  return 1
}

record_manual_upgrade_signal() {
  local signal=$1
  manual_upgrade_wait_signal=${signal}
  manual_upgrade_pending_signal=${signal}
}

forward_manual_upgrade_signal() {
  local signal=$1
  manual_upgrade_wait_signal=${signal}
  if [[ -n ${manual_upgrade_candidate_pid} ]] &&
    manual_upgrade_candidate_is_child_job; then
    manual_upgrade_pending_signal=""
    kill -s "${signal}" -- "${manual_upgrade_candidate_pid}" 2>/dev/null || true
  else
    manual_upgrade_pending_signal=${signal}
  fi
}

run_guarded_upgrade_candidate() {
  local ignore_signals_after=$1
  shift
  local candidate_status=1
  local interrupted_status=0
  local pending_signal=""

  manual_upgrade_candidate_pid=""
  manual_upgrade_wait_signal=""
  manual_upgrade_pending_signal=""
  # Before $! is available, record signals without guessing a PID. Switch to
  # guarded forwarding only after Bash has registered the candidate child job.
  trap 'record_manual_upgrade_signal INT' INT
  trap 'record_manual_upgrade_signal TERM' TERM

  "$@" &
  manual_upgrade_candidate_pid=$!
  trap 'forward_manual_upgrade_signal INT' INT
  trap 'forward_manual_upgrade_signal TERM' TERM
  if [[ -n ${manual_upgrade_pending_signal} ]]; then
    pending_signal=${manual_upgrade_pending_signal}
    forward_manual_upgrade_signal "${pending_signal}"
  fi

  while true; do
    manual_upgrade_wait_signal=""
    if wait "${manual_upgrade_candidate_pid}"; then
      candidate_status=0
    else
      candidate_status=$?
    fi
    case "${manual_upgrade_wait_signal}" in
      INT) interrupted_status=130 ;;
      TERM) interrupted_status=143 ;;
      "") interrupted_status=0 ;;
      *) interrupted_status=1 ;;
    esac
    if [[ ${interrupted_status} -ne 0 &&
      ${candidate_status} -eq ${interrupted_status} ]]; then
      continue
    fi
    break
  done

  manual_upgrade_candidate_pid=""
  manual_upgrade_pending_signal=""
  manual_upgrade_wait_signal=""
  if [[ ${ignore_signals_after} == true ]]; then
    # The manual upgrade candidate's durable final status is authoritative.
    # Once it has been reaped, later wrapper-only signals must not turn a
    # committed success into 130/143 while the wrapper reports the result.
    trap '' INT TERM
  else
    trap 'exit 130' INT
    trap 'exit 143' TERM
  fi
  return "${candidate_status}"
}

run_active_job_recovery_candidate() {
  run_guarded_upgrade_candidate false \
    "${RUNUSER_PATH}" --user "${AGENT_USER}" -- \
    "${ENV_PATH}" -i \
    HOME=/nonexistent \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    LC_ALL=C \
    "${active_job_recovery_candidate_path}" \
    recover-update --config "${CONFIG_DEST}"
}

run_manual_upgrade_candidate() {
  local -a candidate_command=(
    "${LOCAL_EXECUTOR_BINARY_SOURCE}" manual-upgrade-host-runtime
    --artifact-root "${EXTRACTED_ROOT}"
    --archive-sha256 "${ARTIFACT_SHA256}"
    --archive-size "${ARTIFACT_SIZE}"
  )
  if [[ ${recover_active_job} == true ]]; then
    candidate_command+=(--agent-stopped-for-recovery)
  fi
  run_guarded_upgrade_candidate true "${candidate_command[@]}"
}

inspect_active_job_recovery_state() {
  local state
  state="$(${LOCAL_EXECUTOR_BINARY_SOURCE} inspect-host-update-recovery)" || \
    die "candidate Local Executor could not inspect Host update recovery"
  [[ ${state} == "active" || ${state} == "inactive" ]] || \
    die "candidate Local Executor returned an invalid Host update recovery state"
  printf '%s\n' "${state}"
}

if [[ ${install_mode} == "upgrade" ]]; then
  # The private bundle is extracted under umask 077 with
  # --no-same-permissions, so archive files declared as 0644 arrive as 0600.
  # The candidate Executor deliberately requires both migration templates to
  # be root:root 0644 with one link before it can inspect or migrate the
  # installed units. Normalize only these verified, non-executable templates
  # inside the root-only staging directory; keep every other staged file under
  # the restrictive extraction mask.
  chmod 0644 -- \
    "${LOCAL_EXECUTOR_SERVICE_SOURCE}" \
    "${SELF_UPDATE_RECOVERY_SERVICE_SOURCE}" || \
    die "could not normalize the verified systemd unit candidates"
  for verified_unit_candidate in \
    "${LOCAL_EXECUTOR_SERVICE_SOURCE}" \
    "${SELF_UPDATE_RECOVERY_SERVICE_SOURCE}"; do
    [[ -f ${verified_unit_candidate} &&
      ! -L ${verified_unit_candidate} &&
      $(stat -c '%U:%G:%a:%h' -- "${verified_unit_candidate}") == \
        root:root:644:1 ]] || \
      die "verified systemd unit candidate metadata is unsafe: ${verified_unit_candidate}"
  done

  if [[ ${recover_active_job} == true ]]; then
    validate_active_job_recovery_executable \
      "${SYSTEMCTL_PATH}" "systemctl"
    validate_active_job_recovery_executable \
      "${SYSTEMD_RUN_PATH}" "systemd-run"
    validate_active_job_recovery_executable \
      "${RUNUSER_PATH}" "runuser"
    validate_active_job_recovery_executable \
      "${ENV_PATH}" "env"
    validate_active_job_recovery_executable \
      "${TEST_PATH}" "test"
    [[ $(inspect_active_job_recovery_state) == "active" ]] || \
      die "--recover-active-job requires an exact active Host update journal"
    acquire_active_job_recovery_locks
    [[ $(inspect_active_job_recovery_state) == "active" ]] || \
      die "exact active Host update journal settled before recovery could start"
    active_job_recovery_service_is_managed || \
      die "--recover-active-job requires an enabled, active Host Agent with a live MainPID"
    active_job_recovery_live_pair_is_managed || \
      die "--recover-active-job requires an exact permitted live Host Agent and Local Executor A/B pair"
    active_job_recovery_original_pair_is_intact || \
      die "--recover-active-job could not pin the exact pre-stop Host runtime pair"
    prepare_active_job_recovery_guard_candidate
    install_active_job_recovery_clear_fence
    arm_active_job_recovery_guard
    active_job_recovery_stop_attempted=true
    ${SYSTEMCTL_PATH} stop "${UNIT_NAME}" || \
      die "could not stop the Host Agent for active job recovery"
    active_job_recovery_service_is_inactive || \
      die "Host Agent did not become safely inactive for active job recovery"
    prepare_active_job_recovery_candidate
    # Local Executor Reconcile takes this same lock for every root mutation.
    # Keep the setup lock to exclude configure/install/manual-upgrade, but
    # release lifecycle so the bounded candidate can reconcile the exact job.
    release_active_job_recovery_lifecycle_lock || \
      die "could not release the lifecycle lock for exact active job recovery"
    active_job_recovery_status=0
    run_active_job_recovery_candidate || active_job_recovery_status=$?
    if [[ ${active_job_recovery_status} -ne 0 ]]; then
      printf '%s\n' \
        'install-autostream-host-agent: exact active Host update recovery failed' >&2
      exit "${active_job_recovery_status}"
    fi
    reacquire_active_job_recovery_lifecycle_lock
    [[ $(inspect_active_job_recovery_state) == "inactive" ]] || \
      die "candidate Host Agent did not settle the exact active Host update journal"
    release_active_job_recovery_locks || \
      die "could not release active-job recovery locks before the managed runtime upgrade"
  fi

  manual_upgrade_status=0
  run_manual_upgrade_candidate || manual_upgrade_status=$?
  if [[ ${manual_upgrade_status} -ne 0 ]]; then
    printf '%s\n' \
      'install-autostream-host-agent: managed Host runtime upgrade failed' >&2
    exit "${manual_upgrade_status}"
  fi
  if [[ ${recover_active_job} == true ]]; then
    active_job_recovery_upgrade_committed=true
    cleanup_active_job_recovery || \
      die "managed Host runtime upgrade completed but recovery cleanup failed"
  fi
  printf '%s\n' "Verified Host Agent bundle archive SHA-256: ${ARTIFACT_SHA256}"
  printf '%s\n' "Managed Host Agent and Local Executor runtime upgrade complete."
  exit 0
fi

acquire_shared_host_setup_lock
acquire_host_lifecycle_lock

copy_verified_release_file() {
  local source=$1
  local destination=$2
  local owner=$3
  local group=$4
  local mode=$5
  local label=$6
  local source_identity
  local source_sha256
  [[ -f ${source} && ! -L ${source} ]] || die "${label} release source is missing or unsafe"
  source_identity=$(stat -c '%d:%i:%s:%Y:%f' -- "${source}")
  source_sha256=$(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }')
  install -o "${owner}" -g "${group}" -m "${mode}" "${source}" "${destination}"
  [[ -f ${source} && ! -L ${source} ]] || die "${label} release source changed while it was copied"
  [[ $(stat -c '%d:%i:%s:%Y:%f' -- "${source}") == "${source_identity}" ]] || \
    die "${label} release source identity changed while it was copied"
  [[ $(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "${label} release source content changed while it was copied"
  [[ $(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "staged ${label} does not match the verified release source"
}

copy_verified_config_file() {
  local source=$1
  local destination=$2
  local source_identity
  local source_sha256
  validate_root_owned_config_source "${source}"
  source_identity=$(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${source}")
  source_sha256=$(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }')
  install -o root -g "${AGENT_GROUP}" -m 0640 "${source}" "${destination}"
  validate_root_owned_config_source "${source}"
  [[ $(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${source}") == "${source_identity}" ]] || \
    die "config source identity changed while it was copied"
  [[ $(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "config source content changed while it was copied"
  [[ $(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "staged identity does not match the verified config source"
}

