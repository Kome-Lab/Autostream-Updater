#!/bin/bash
set -euo pipefail

umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly AGENT_USER="autostream-host-agent"
readonly AGENT_GROUP="autostream-host-agent"
readonly CONFIG_DIR="/etc/autostream-local-executor"
readonly POLICY_DEST="${CONFIG_DIR}/policy.json"
readonly BINARY_DEST="/usr/local/libexec/autostream-local-executor"
readonly SERVICE_DEST="/etc/systemd/system/autostream-local-executor.service"
readonly SOCKET_DEST="/etc/systemd/system/autostream-local-executor.socket"
readonly TMPFILES_DEST="/etc/tmpfiles.d/autostream-local-executor.conf"
readonly SERVICE_NAME="autostream-local-executor.service"
readonly SOCKET_NAME="autostream-local-executor.socket"
readonly HOST_AGENT_SERVICE_NAME="autostream-host-agent.service"
readonly SOCKET_DIR="/run/autostream-local-executor"
readonly UPDATER_RUNTIME_DIR="/run/autostream-updater"
readonly SHARED_HOST_SETUP_LOCK="${UPDATER_RUNTIME_DIR}/.autostream-runtime-host-setup.lock"
readonly HOST_LIFECYCLE_LOCK="${UPDATER_RUNTIME_DIR}/.autostream-host-lifecycle.lock"
readonly STATE_DIR="/var/lib/autostream-local-executor"
readonly DOCKER_CONFIG_DIR="${CONFIG_DIR}/docker"
readonly DOCKER_CONFIG_FILE="${DOCKER_CONFIG_DIR}/config.json"
readonly EXECUTOR_DATA_DIR="/opt/autostream/local-executor"
readonly PORT_CONFIG_DIR="${EXECUTOR_DATA_DIR}/ports"
readonly DOCKER_VERSION_DIR="${EXECUTOR_DATA_DIR}/docker"
readonly DOCKER_PORT_CONFIG_DIR="${DOCKER_VERSION_DIR}/ports"
readonly HOST_RUNTIME_ROOT="/opt/autostream/host-agent"
readonly HOST_RUNTIME_CURRENT="${HOST_RUNTIME_ROOT}/current"
readonly ARTIFACT_MANIFEST_NAME="artifact-manifest.json"
readonly MAX_ARCHIVE_SIZE=268435456

usage() {
  printf '%s\n' "Usage: install-autostream-local-executor --policy PATH"
}

die() {
  printf 'install-autostream-local-executor: %s\n' "$*" >&2
  exit 1
}

pending_cleanup_signal=""

defer_cleanup_signals() {
  trap 'pending_cleanup_signal=INT' INT
  trap 'pending_cleanup_signal=TERM' TERM
}

resume_cleanup_signals() {
  trap 'exit 130' INT
  trap 'exit 143' TERM
  local deferred_signal=${pending_cleanup_signal}
  pending_cleanup_signal=""
  case "${deferred_signal}" in
    "") return 0 ;;
    INT) return 130 ;;
    TERM) return 143 ;;
    *) return 1 ;;
  esac
}

arm_cleanup_handler() {
  local handler=$1
  trap "${handler}" EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

validate_root_parent_chain() {
  local label=${2:-policy source}
  local current
  local parent
  local mode
  current=$(dirname -- "$1")
  while true; do
    [[ -d ${current} && ! -L ${current} ]] || die "${label} parents must be non-symlink directories"
    [[ $(stat -c '%U:%G' -- "${current}") == "root:root" ]] || \
      die "${label} parents must be owned by root:root"
    mode=$(stat -c '%a' -- "${current}")
    (( (8#${mode} & 0022) == 0 )) || \
      die "${label} parents must not be writable by group or other"
    parent=$(dirname -- "${current}")
    [[ ${parent} == "${current}" ]] && break
    current=${parent}
  done
}

acquire_shared_host_setup_lock() {
  local directory_identity
  local fd_identity
  local lock_created=false

  # The published lock path is permanent coordination state. Never unlink it:
  # doing so while another process holds the old inode would split the lock.
  validate_root_parent_chain "${UPDATER_RUNTIME_DIR}" "shared host-setup lock"
  if [[ -e ${UPDATER_RUNTIME_DIR} || -L ${UPDATER_RUNTIME_DIR} ]]; then
    [[ -d ${UPDATER_RUNTIME_DIR} &&
      ! -L ${UPDATER_RUNTIME_DIR} &&
      $(readlink -f -- "${UPDATER_RUNTIME_DIR}") == "${UPDATER_RUNTIME_DIR}" &&
      $(stat -c '%U:%G:%a' -- "${UPDATER_RUNTIME_DIR}") == "root:root:700" ]] || \
      die "shared host-setup lock directory is unsafe"
  else
    install -d -o root -g root -m 0700 "${UPDATER_RUNTIME_DIR}" || \
      die "could not create the shared host-setup lock directory"
    [[ -d ${UPDATER_RUNTIME_DIR} &&
      ! -L ${UPDATER_RUNTIME_DIR} &&
      $(readlink -f -- "${UPDATER_RUNTIME_DIR}") == "${UPDATER_RUNTIME_DIR}" &&
      $(stat -c '%U:%G:%a' -- "${UPDATER_RUNTIME_DIR}") == "root:root:700" ]] || \
      die "could not create a safe shared host-setup lock directory"
    sync -f /run
  fi
  validate_root_parent_chain "${SHARED_HOST_SETUP_LOCK}" "shared host-setup lock"
  directory_identity="$(stat -c '%d:%i' -- "${UPDATER_RUNTIME_DIR}")" || \
    die "could not record the shared host-setup lock directory identity"

  if [[ -e ${SHARED_HOST_SETUP_LOCK} || -L ${SHARED_HOST_SETUP_LOCK} ]]; then
    [[ -f ${SHARED_HOST_SETUP_LOCK} &&
      ! -L ${SHARED_HOST_SETUP_LOCK} &&
      $(readlink -f -- "${SHARED_HOST_SETUP_LOCK}") == "${SHARED_HOST_SETUP_LOCK}" &&
      $(stat -c '%U:%G:%a:%h' -- "${SHARED_HOST_SETUP_LOCK}") == "root:root:600:1" ]] || \
      die "shared host-setup lock path is unsafe"
  else
    lock_created=true
  fi
  exec 8<>"${SHARED_HOST_SETUP_LOCK}" || die "could not open the shared host-setup lock"
  fd_identity="$(stat -Lc '%d:%i' -- /proc/self/fd/8)" || \
    die "could not record the shared host-setup lock identity"
  [[ $(stat -c '%d:%i' -- "${UPDATER_RUNTIME_DIR}") == "${directory_identity}" &&
    -f ${SHARED_HOST_SETUP_LOCK} &&
    ! -L ${SHARED_HOST_SETUP_LOCK} &&
    -f /proc/self/fd/8 &&
    $(stat -c '%U:%G:%a:%h' -- "${SHARED_HOST_SETUP_LOCK}") == "root:root:600:1" &&
    $(stat -Lc '%U:%G:%a:%h' -- /proc/self/fd/8) == "root:root:600:1" &&
    ${fd_identity} == "$(stat -c '%d:%i' -- "${SHARED_HOST_SETUP_LOCK}")" ]] || \
    die "shared host-setup lock identity changed while being opened"
  if [[ ${lock_created} == true ]]; then
    sync -f "${UPDATER_RUNTIME_DIR}"
  fi
  flock -n 8 || die "another AutoStream installer is provisioning shared host state"
  [[ $(stat -c '%d:%i' -- "${UPDATER_RUNTIME_DIR}") == "${directory_identity}" &&
    -f ${SHARED_HOST_SETUP_LOCK} &&
    ! -L ${SHARED_HOST_SETUP_LOCK} &&
    -f /proc/self/fd/8 &&
    $(stat -c '%U:%G:%a:%h' -- "${SHARED_HOST_SETUP_LOCK}") == "root:root:600:1" &&
    $(stat -Lc '%U:%G:%a:%h' -- /proc/self/fd/8) == "root:root:600:1" &&
    ${fd_identity} == "$(stat -c '%d:%i' -- "${SHARED_HOST_SETUP_LOCK}")" ]] || \
    die "shared host-setup lock identity changed after acquisition"
}

acquire_host_lifecycle_lock() {
  local directory_identity
  local fd_identity
  local lock_created=false

  validate_root_parent_chain "${HOST_LIFECYCLE_LOCK}" "Host lifecycle lock"
  [[ -d ${UPDATER_RUNTIME_DIR} &&
    ! -L ${UPDATER_RUNTIME_DIR} &&
    $(readlink -f -- "${UPDATER_RUNTIME_DIR}") == "${UPDATER_RUNTIME_DIR}" &&
    $(stat -c '%U:%G:%a' -- "${UPDATER_RUNTIME_DIR}") == "root:root:700" ]] || \
    die "Host lifecycle lock directory is unsafe"
  directory_identity="$(stat -c '%d:%i' -- "${UPDATER_RUNTIME_DIR}")" || \
    die "could not record the Host lifecycle lock directory identity"

  if [[ -e ${HOST_LIFECYCLE_LOCK} || -L ${HOST_LIFECYCLE_LOCK} ]]; then
    [[ -f ${HOST_LIFECYCLE_LOCK} &&
      ! -L ${HOST_LIFECYCLE_LOCK} &&
      $(readlink -f -- "${HOST_LIFECYCLE_LOCK}") == "${HOST_LIFECYCLE_LOCK}" &&
      $(stat -c '%U:%G:%a:%h' -- "${HOST_LIFECYCLE_LOCK}") == "root:root:600:1" ]] || \
      die "Host lifecycle lock path is unsafe"
  else
    lock_created=true
  fi
  exec 9<>"${HOST_LIFECYCLE_LOCK}" || die "could not open the Host lifecycle lock"
  fd_identity="$(stat -Lc '%d:%i' -- /proc/self/fd/9)" || \
    die "could not record the Host lifecycle lock identity"
  [[ $(stat -c '%d:%i' -- "${UPDATER_RUNTIME_DIR}") == "${directory_identity}" &&
    -f ${HOST_LIFECYCLE_LOCK} &&
    ! -L ${HOST_LIFECYCLE_LOCK} &&
    -f /proc/self/fd/9 &&
    $(stat -c '%U:%G:%a:%h' -- "${HOST_LIFECYCLE_LOCK}") == "root:root:600:1" &&
    $(stat -Lc '%U:%G:%a:%h' -- /proc/self/fd/9) == "root:root:600:1" &&
    ${fd_identity} == "$(stat -c '%d:%i' -- "${HOST_LIFECYCLE_LOCK}")" ]] || \
    die "Host lifecycle lock identity changed while being opened"
  if [[ ${lock_created} == true ]]; then
    sync -f "${UPDATER_RUNTIME_DIR}"
  fi
  flock -n 9 || die "another privileged Host lifecycle operation is active"
  [[ $(stat -c '%d:%i' -- "${UPDATER_RUNTIME_DIR}") == "${directory_identity}" &&
    -f ${HOST_LIFECYCLE_LOCK} &&
    ! -L ${HOST_LIFECYCLE_LOCK} &&
    -f /proc/self/fd/9 &&
    $(stat -c '%U:%G:%a:%h' -- "${HOST_LIFECYCLE_LOCK}") == "root:root:600:1" &&
    $(stat -Lc '%U:%G:%a:%h' -- /proc/self/fd/9) == "root:root:600:1" &&
    ${fd_identity} == "$(stat -c '%d:%i' -- "${HOST_LIFECYCLE_LOCK}")" ]] || \
    die "Host lifecycle lock identity changed after acquisition"
}

policy_source=
case "${1:-}" in
  --policy)
    [[ $# -eq 2 ]] || {
      usage >&2
      exit 1
    }
    policy_source=$2
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

for command in awk basename chmod chown dirname find flock getent id install jq mkdir mktemp mv pwd readlink rm rmdir sha256sum sort stat sync systemctl systemd-tmpfiles tar uname uniq; do
  command -v "${command}" >/dev/null 2>&1 || die "required command ${command} is unavailable"
done

[[ ${EUID} -eq 0 ]] || die "must run as root"
[[ ${policy_source} == /* ]] || die "--policy must be an absolute path"
[[ -f ${policy_source} && ! -L ${policy_source} ]] || die "policy source must be a regular non-symlink file"
validate_root_parent_chain "${policy_source}"
[[ $(stat -c '%U:%G:%a' -- "${policy_source}") == "root:root:600" ]] || \
  die "policy source must be root:root 0600"

readonly RELEASE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
ARTIFACT_ID="$(basename -- "${RELEASE_ROOT}")" || die "could not resolve the Host Agent release directory name"
readonly ARTIFACT_ID
if [[ ! ${ARTIFACT_ID} =~ ^autostream-host-agent_(v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?)_linux_(amd64|arm64)$ ]]; then
  die "the extracted Host Agent directory name is invalid: ${ARTIFACT_ID}"
fi
readonly VERSION="${BASH_REMATCH[1]}"
readonly ARCH="${BASH_REMATCH[4]}"
case "$(uname -m)" in
  x86_64) readonly HOST_ARCH="amd64" ;;
  aarch64|arm64) readonly HOST_ARCH="arm64" ;;
  *) die "unsupported host architecture: $(uname -m)" ;;
esac
[[ ${ARCH} == "${HOST_ARCH}" ]] || \
  die "artifact architecture ${ARCH} does not match host ${HOST_ARCH}"

ARTIFACT_PARENT="$(dirname -- "${RELEASE_ROOT}")" || die "could not resolve the release parent directory"
readonly ARTIFACT_PARENT
readonly ARCHIVE_NAME="${ARTIFACT_ID}.tar.gz"
readonly ARCHIVE_SOURCE="${ARTIFACT_PARENT}/${ARCHIVE_NAME}"
readonly RUNNING_INSTALLER_SOURCE="${RELEASE_ROOT}/install/install-autostream-local-executor"
readonly RUNNING_HOST_BINARY_SOURCE="${RELEASE_ROOT}/bin/autostream-host-agent"
readonly RUNNING_BINARY_SOURCE="${RELEASE_ROOT}/bin/autostream-local-executor"
readonly RUNNING_SERVICE_SOURCE="${RELEASE_ROOT}/systemd/autostream-local-executor.service"
readonly RUNNING_SOCKET_SOURCE="${RELEASE_ROOT}/systemd/autostream-local-executor.socket"
readonly RUNNING_TMPFILES_SOURCE="${RELEASE_ROOT}/systemd/autostream-local-executor.tmpfiles"

validate_root_owned_release_source() {
  local source=$1
  local source_mode
  [[ -f ${source} && ! -L ${source} ]] || die "release asset ${source} is missing or unsafe"
  [[ $(stat -c '%U:%G' -- "${source}") == "root:root" ]] || \
    die "release asset ${source} must be owned by root:root"
  source_mode=$(stat -c '%a' -- "${source}")
  (( (8#${source_mode} & 0022) == 0 )) || \
    die "release asset ${source} must not be writable by group or other"
  validate_root_parent_chain "${source}" "release source"
}

for source in \
  "${RUNNING_INSTALLER_SOURCE}" \
  "${RUNNING_HOST_BINARY_SOURCE}" \
  "${RUNNING_BINARY_SOURCE}" \
  "${RUNNING_SERVICE_SOURCE}" \
  "${RUNNING_SOCKET_SOURCE}" \
  "${RUNNING_TMPFILES_SOURCE}" \
  "${ARCHIVE_SOURCE}"; do
  validate_root_owned_release_source "${source}"
done

ARTIFACT_SOURCE_SIZE="$(stat -c %s -- "${ARCHIVE_SOURCE}")" || \
  die "could not determine the source archive size"
[[ ${ARTIFACT_SOURCE_SIZE} =~ ^[1-9][0-9]*$ ]] || die "source archive size is invalid"
[[ ${ARTIFACT_SOURCE_SIZE} -le ${MAX_ARCHIVE_SIZE} ]] || \
  die "source archive exceeds the ${MAX_ARCHIVE_SIZE}-byte limit"
readonly ARTIFACT_SOURCE_SIZE

BUNDLE_STAGE=""
cleanup_bundle_stage() {
  local status=$?
  trap '' INT TERM
  trap - EXIT
  if [[ -n ${BUNDLE_STAGE:-} &&
    ${BUNDLE_STAGE} == /var/tmp/autostream-local-executor-install.* &&
    -d ${BUNDLE_STAGE} &&
    ! -L ${BUNDLE_STAGE} ]]; then
    rm -rf -- "${BUNDLE_STAGE}"
  fi
  exit "${status}"
}
arm_cleanup_handler cleanup_bundle_stage

defer_cleanup_signals
BUNDLE_STAGE="$(mktemp -d /var/tmp/autostream-local-executor-install.XXXXXXXX)" || \
  die "could not create the private bundle staging directory"
resume_cleanup_signals || die "installation was interrupted while creating the private bundle stage"
[[ -n ${BUNDLE_STAGE} &&
  ${BUNDLE_STAGE} == /var/tmp/autostream-local-executor-install.* &&
  -d ${BUNDLE_STAGE} &&
  ! -L ${BUNDLE_STAGE} ]] || die "private bundle staging directory is invalid"
[[ $(readlink -f -- "${BUNDLE_STAGE}") == "${BUNDLE_STAGE}" &&
  $(stat -c '%U:%G:%a' -- "${BUNDLE_STAGE}") == "root:root:700" ]] || \
  die "private bundle staging directory ownership, mode, or canonical path is invalid"
readonly BUNDLE_STAGE
readonly UNPACK_DIR="${BUNDLE_STAGE}/unpack"

install -d -o root -g root -m 0700 "${UNPACK_DIR}"

copy_stable_bundle_archive() {
  local source_identity
  local source_sha256
  source_identity="$(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${ARCHIVE_SOURCE}")"
  source_sha256="$(sha256sum -- "${ARCHIVE_SOURCE}" | awk 'NR == 1 { print $1 }')"
  install -o root -g root -m 0600 "${ARCHIVE_SOURCE}" "${BUNDLE_STAGE}/${ARCHIVE_NAME}"
  validate_root_owned_release_source "${ARCHIVE_SOURCE}"
  [[ $(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${ARCHIVE_SOURCE}") == "${source_identity}" ]] || \
    die "bundle archive identity changed while it was copied"
  [[ $(sha256sum -- "${ARCHIVE_SOURCE}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "bundle archive content changed while it was copied"
  [[ $(sha256sum -- "${BUNDLE_STAGE}/${ARCHIVE_NAME}" | awk 'NR == 1 { print $1 }') == "${source_sha256}" ]] || \
    die "staged bundle archive differs from its source"
}

copy_stable_bundle_archive
ARTIFACT_SHA256="$(
  sha256sum -- "${BUNDLE_STAGE}/${ARCHIVE_NAME}" | awk 'NR == 1 { print $1 }'
)" || die "could not calculate the bundle archive digest"
[[ ${ARTIFACT_SHA256} =~ ^[0-9a-f]{64}$ ]] || die "bundle archive digest is invalid"
readonly ARTIFACT_SHA256
ARTIFACT_SIZE="$(stat -c %s -- "${BUNDLE_STAGE}/${ARCHIVE_NAME}")" || \
  die "could not determine the staged archive size"
[[ ${ARTIFACT_SIZE} =~ ^[1-9][0-9]*$ ]] || die "staged archive size is invalid"
[[ ${ARTIFACT_SIZE} -le ${MAX_ARCHIVE_SIZE} ]] || \
  die "staged archive exceeds the ${MAX_ARCHIVE_SIZE}-byte limit"
[[ ${ARTIFACT_SIZE} == "${ARTIFACT_SOURCE_SIZE}" ]] || \
  die "staged bundle archive size differs from its source"
readonly ARTIFACT_SIZE

tar -tzf "${BUNDLE_STAGE}/${ARCHIVE_NAME}" > "${BUNDLE_STAGE}/archive.list"
[[ -s ${BUNDLE_STAGE}/archive.list ]] || die "bundle archive is empty"
while IFS= read -r entry; do
  [[ ${entry} == "${ARTIFACT_ID}" || ${entry} == "${ARTIFACT_ID}/" ||
    ${entry} == "${ARTIFACT_ID}/"* ]] || \
    die "bundle archive contains a path outside ${ARTIFACT_ID}: ${entry}"
  [[ ${entry} != /* &&
    ${entry} != *\\* &&
    ${entry} != ../* &&
    ${entry} != *"/../"* &&
    ${entry} != *"/.." &&
    ${entry} != *"/./"* &&
    ${entry} != *"/." &&
    ${entry} != *"//"* ]] || \
    die "bundle archive contains an unsafe path: ${entry}"
done < "${BUNDLE_STAGE}/archive.list"
duplicate_paths="$(
  awk '{ sub(/\/$/, ""); print }' "${BUNDLE_STAGE}/archive.list" |
    LC_ALL=C sort |
    uniq -d
)"
[[ -z ${duplicate_paths} ]] || die "bundle archive contains duplicate paths"
while IFS= read -r entry; do
  case "${entry:0:1}" in
    -|d) ;;
    *) die "bundle archive contains a non-regular entry" ;;
  esac
done < <(tar -tvzf "${BUNDLE_STAGE}/${ARCHIVE_NAME}")

tar --no-same-owner --no-same-permissions \
  -xzf "${BUNDLE_STAGE}/${ARCHIVE_NAME}" \
  -C "${UNPACK_DIR}"
readonly EXTRACTED_ROOT="${UNPACK_DIR}/${ARTIFACT_ID}"
[[ -d ${EXTRACTED_ROOT} && ! -L ${EXTRACTED_ROOT} ]] || \
  die "bundle archive root is missing or unsafe"
[[ -z $(find "${UNPACK_DIR}" -mindepth 1 -maxdepth 1 ! -name "${ARTIFACT_ID}" -print -quit) ]] || \
  die "bundle archive contains more than one top-level path"
[[ -z $(find "${EXTRACTED_ROOT}" -type l -print -quit) ]] || \
  die "bundle archive must not contain symlinks"
[[ -f ${EXTRACTED_ROOT}/checksums.txt && ! -L ${EXTRACTED_ROOT}/checksums.txt ]] || \
  die "bundle checksums.txt is missing or unsafe"
[[ -f ${EXTRACTED_ROOT}/${ARTIFACT_MANIFEST_NAME} &&
  ! -L ${EXTRACTED_ROOT}/${ARTIFACT_MANIFEST_NAME} ]] || \
  die "bundle ${ARTIFACT_MANIFEST_NAME} is missing or unsafe"

verify_release_checksum_inventory() {
  local root=$1
  local checksum_entry
  local checked_path
  local release_file
  local relative_path
  local -A listed=()
  while IFS= read -r checksum_entry; do
    [[ ${checksum_entry} =~ ^[0-9a-f]{64}\ \ (.+)$ ]] || \
      die "inner checksum entry has an invalid format"
    checked_path="${BASH_REMATCH[1]}"
    [[ ${checked_path} == ./* ]] || die "inner checksum entry must use a ./ relative path"
    checked_path="${checked_path#./}"
    [[ -n ${checked_path} &&
      ${checked_path} != /* &&
      ${checked_path} != ./* &&
      ${checked_path} != *\\* &&
      ${checked_path} != ../* &&
      ${checked_path} != *"/../"* &&
      ${checked_path} != *"/.." &&
      ${checked_path} != *"/./"* &&
      ${checked_path} != *"/." &&
      ${checked_path} != *"//"* &&
      ${checked_path} != "checksums.txt" ]] || die "inner checksum entry has an unsafe path"
    [[ -z ${listed["${checked_path}"]+present} ]] || \
      die "inner checksum entry is duplicated: ${checked_path}"
    listed["${checked_path}"]=1
    [[ -f ${root}/${checked_path} && ! -L ${root}/${checked_path} ]] || \
      die "inner checksum entry does not name a regular file: ${checked_path}"
  done < "${root}/checksums.txt"
  [[ ${#listed[@]} -gt 0 ]] || die "bundle checksums.txt contains no files"
  while IFS= read -r -d '' release_file; do
    relative_path="${release_file#"${root}/"}"
    [[ ${relative_path} == "checksums.txt" ]] && continue
    [[ -n ${listed["${relative_path}"]+present} ]] || \
      die "release file is not listed in checksums.txt: ${relative_path}"
  done < <(find "${root}" -type f -print0)
  [[ -z $(find "${root}" -mindepth 1 ! -type d ! -type f -print -quit) ]] || \
    die "bundle tree contains a symlink or non-regular file"
}

verify_release_checksum_inventory "${EXTRACTED_ROOT}"
(cd -- "${EXTRACTED_ROOT}" && sha256sum --check --strict checksums.txt)

jq -e \
  --arg version "${VERSION}" \
  --arg arch "${ARCH}" \
  --arg archive_name "${ARCHIVE_NAME}" \
  --arg artifact_id "${ARTIFACT_ID}" \
  '((keys | sort) ==
      ["archive", "build_date", "commit", "compatibility", "component",
       "platform", "schema_version", "source_version"]) and
   (.schema_version == 1) and
   (.component == "host-agent") and
   (.source_version == $version) and
   (.commit | type == "string" and test("^[0-9a-f]{40}$")) and
   (.build_date | type == "string" and
    test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
   (.platform |
     ((keys | sort) == ["arch", "os"]) and
     (.os == "linux") and
     (.arch == $arch)) and
   (.archive |
     ((keys | sort) == ["name", "root"]) and
     (.name == $archive_name) and
     (.root == $artifact_id)) and
   (.compatibility |
     ((keys | sort) ==
       ["database_schema", "minimum_agent_version", "minimum_panel_version",
        "rollback_compatible"]) and
     (.minimum_agent_version == null) and
     (.minimum_panel_version == $version) and
     (.rollback_compatible == true) and
     (.database_schema == "none"))' \
  "${EXTRACTED_ROOT}/${ARTIFACT_MANIFEST_NAME}" >/dev/null || \
  die "${ARTIFACT_MANIFEST_NAME} does not authorize this exact Host Agent bundle"
MANIFEST_COMMIT="$(jq -er '.commit' "${EXTRACTED_ROOT}/${ARTIFACT_MANIFEST_NAME}")" || \
  die "could not read the bundle commit"
readonly MANIFEST_COMMIT
MANIFEST_BUILD_DATE="$(jq -er '.build_date' "${EXTRACTED_ROOT}/${ARTIFACT_MANIFEST_NAME}")" || \
  die "could not read the bundle build date"
readonly MANIFEST_BUILD_DATE

readonly HOST_BINARY_SOURCE="${EXTRACTED_ROOT}/bin/autostream-host-agent"
readonly BINARY_SOURCE="${EXTRACTED_ROOT}/bin/autostream-local-executor"
readonly SERVICE_SOURCE="${EXTRACTED_ROOT}/systemd/autostream-local-executor.service"
readonly SOCKET_SOURCE="${EXTRACTED_ROOT}/systemd/autostream-local-executor.socket"
readonly TMPFILES_SOURCE="${EXTRACTED_ROOT}/systemd/autostream-local-executor.tmpfiles"
readonly VERIFIED_INSTALLER_SOURCE="${EXTRACTED_ROOT}/install/install-autostream-local-executor"

for source in \
  "${HOST_BINARY_SOURCE}" \
  "${BINARY_SOURCE}" \
  "${SERVICE_SOURCE}" \
  "${SOCKET_SOURCE}" \
  "${TMPFILES_SOURCE}" \
  "${VERIFIED_INSTALLER_SOURCE}"; do
  [[ -f ${source} && ! -L ${source} ]] || \
    die "required verified Host Agent bundle file is missing or unsafe: ${source}"
done
[[ -x ${HOST_BINARY_SOURCE} && -x ${BINARY_SOURCE} ]] || \
  die "Host Agent bundle binaries are not executable"
[[ $(sha256sum -- "${RUNNING_INSTALLER_SOURCE}" | awk 'NR == 1 { print $1 }') == \
  "$(sha256sum -- "${VERIFIED_INSTALLER_SOURCE}" | awk 'NR == 1 { print $1 }')" ]] || \
  die "running local executor installer does not match the verified bundle"

