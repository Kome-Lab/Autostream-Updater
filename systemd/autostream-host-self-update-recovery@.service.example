[Unit]
Description=AutoStream Host Agent A/B self-update recovery for slot %i
Documentation=https://github.com/Kome-Lab/Autostream-Updater
ConditionPathExists=/var/lib/autostream-local-executor/host-self-update/state.json
ConditionFileIsExecutable=/opt/autostream/host-agent/slots/%i/bin/autostream-local-executor
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/autostream/host-agent/slots/%i/bin/autostream-local-executor recover-self-update --recovery-slot %i
TimeoutStartSec=60s
UMask=0077
Environment=HOME=/
RuntimeDirectory=autostream-updater
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SocketBindDeny=any
InaccessiblePaths=/etc/autostream
InaccessiblePaths=/etc/autostream/updater /etc/autostream-local-executor
ReadWritePaths=/var/lib/autostream-local-executor
ReadWritePaths=/opt/autostream/host-agent
ReadWritePaths=-/run/autostream-updater
